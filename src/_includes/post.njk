---
layout: default.njk
---

<div class="blog-post-wrapper">
  <!-- Post Header -->
  <header class="blog-post-header">
    <div class="container">
      <a href="/blog/" class="back-to-blog-link">
        <i class="fa-solid fa-arrow-left"></i> Back to News &amp; Insights
      </a>

      <div class="blog-post-header-content">
        <div class="blog-meta-pills">
          <span class="blog-category-badge">GUIDE &amp; INSIGHTS</span>
          {% if date %}<span class="blog-post-date">{{ date | postDate }}</span>{% endif %}
        </div>

        <h1 class="blog-post-hero-title">{{ title }}</h1>
        {% if description %}
          <p class="blog-post-lead">{{ description }}</p>
        {% endif %}
      </div>
    </div>
  </header>

  <!-- Post Body Container -->
  <main class="blog-post-container">
    <article class="blog-content">
      {{ content | safe }}
    </article>

    <!-- Post Bottom CTA Section -->
    <div class="blog-post-cta">
      <div class="blog-cta-inner">
        <span class="cta-subtitle">CONSULTATION &amp; ADVICE</span>
        <h3>Ready to Upgrade Your Space?</h3>
        <p>Book a private consultation with our master electricians to discuss smart lighting, high speed Starlink networking, or custom security for your property.</p>
        <div class="blog-cta-actions">
          <a href="/contact/" class="btn-primary">Book Consultation <i class="fa-solid fa-arrow-right"></i></a>
          <a href="tel:6136144463" class="btn-secondary"><i class="fa-solid fa-phone"></i> (613) 614-4463</a>
        </div>
      </div>
    </div>
  </main>
</div>

<style>
  .blog-post-wrapper {
    background: var(--bg-canvas, #f8fafc);
    padding-bottom: 6rem;
  }

  .blog-post-header {
    background: #0f172a;
    color: #ffffff;
    padding: 5rem 0 4rem 0;
    position: relative;
    overflow: hidden;
  }

  .blog-post-header::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at 80% 20%, rgba(255, 65, 3, 0.12) 0%, transparent 60%);
    pointer-events: none;
  }

  .back-to-blog-link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: #94a3b8;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
    margin-bottom: 2.5rem;
    transition: color 0.25s ease, transform 0.25s ease;
  }

  .back-to-blog-link:hover {
    color: #ffffff;
    transform: translateX(-3px);
  }

  .blog-meta-pills {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 1.25rem;
  }

  .blog-category-badge {
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: #FF4103;
    text-transform: uppercase;
  }

  .blog-post-date {
    font-size: 0.85rem;
    color: #94a3b8;
    font-weight: 500;
  }

  .blog-post-hero-title {
    font-size: 2.75rem;
    line-height: 1.2;
    font-weight: 800;
    color: #ffffff;
    max-width: 900px;
    margin-bottom: 1.25rem;
    font-family: var(--font-heading);
  }

  .blog-post-lead {
    font-size: 1.2rem;
    line-height: 1.6;
    color: #cbd5e1;
    max-width: 800px;
  }

  .blog-post-container {
    max-width: 820px;
    margin: 3.5rem auto 0 auto;
    padding: 0 1.5rem;
  }

  .blog-content {
    background: #ffffff;
    border: 1px solid var(--border-subtle, rgba(0, 0, 0, 0.08));
    border-radius: 16px;
    padding: 3.5rem 3rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.03);
    font-size: 1.125rem;
    line-height: 1.85;
    color: #334155;
  }

  .blog-content h2 {
    font-size: 1.85rem;
    font-weight: 800;
    color: #0f172a;
    margin-top: 2.75rem;
    margin-bottom: 1.25rem;
    font-family: var(--font-heading);
    letter-spacing: -0.02em;
  }

  .blog-content h3 {
    font-size: 1.4rem;
    font-weight: 700;
    color: #0f172a;
    margin-top: 2.25rem;
    margin-bottom: 1rem;
    font-family: var(--font-heading);
  }

  .blog-content p {
    margin-bottom: 1.6rem;
  }

  .blog-content ul, .blog-content ol {
    margin-bottom: 2rem;
    padding-left: 1.75rem;
  }

  .blog-content li {
    margin-bottom: 0.6rem;
  }

  .blog-post-cta {
    margin-top: 4rem;
    background: #ffffff;
    border: 1px solid rgba(255, 65, 3, 0.2);
    border-radius: 16px;
    padding: 3rem 2.5rem;
    text-align: center;
    box-shadow: 0 12px 30px rgba(255, 65, 3, 0.04);
  }

  .cta-subtitle {
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: #FF4103;
    display: block;
    margin-bottom: 0.5rem;
  }

  .blog-post-cta h3 {
    font-size: 1.8rem;
    font-weight: 800;
    color: #0f172a;
    margin-bottom: 0.75rem;
  }

  .blog-post-cta p {
    font-size: 1.05rem;
    color: #64748b;
    max-width: 600px;
    margin: 0 auto 2rem auto;
    line-height: 1.6;
  }

  .blog-cta-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: linear-gradient(135deg, #FF4103 0%, #c73200 100%);
    color: #ffffff;
    padding: 0.85rem 1.75rem;
    border-radius: 8px;
    font-weight: 700;
    text-decoration: none;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(255, 65, 3, 0.3);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: #f1f5f9;
    color: #0f172a;
    padding: 0.85rem 1.75rem;
    border-radius: 8px;
    font-weight: 700;
    text-decoration: none;
    transition: background 0.25s ease, transform 0.25s ease;
  }

  .btn-secondary:hover {
    background: #e2e8f0;
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    .blog-post-hero-title {
      font-size: 2rem;
    }
    .blog-content {
      padding: 2rem 1.5rem;
    }
    .blog-post-cta {
      padding: 2rem 1.5rem;
    }
  }
</style>

