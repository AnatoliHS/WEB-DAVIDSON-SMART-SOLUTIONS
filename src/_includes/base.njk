<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{ title | default("Automation - Convenience at your fingertips") }} — {{ site.title }}</title>
  <meta name="description" content="{{ description | default(site.description) }}" />

  <!-- Google Fonts & Font Awesome Icons -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&display=swap"
    rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

  <!-- Editorial Stylesheet -->
  <link rel="stylesheet" href="/assets/css/style.css?v=4.0" />

  <!-- Favicon -->
  <link rel="icon"
    href="https://i0.wp.com/quintesmarthomes.ca/wp-content/uploads/2023/06/Quinte-Smart-Homes-House-Logo.png?fit=32%2C32&ssl=1"
    sizes="32x32" />
</head>

<body class="{% if isBusinessPage or page.url == '/business/' %}business-portal{% endif %}">
  <!-- Thinking Wave Visualizer Ring around Closed Navbar Circle (Desktop Only) -->
  <div class="pill-thinking-orb" id="pillThinkingOrb" aria-hidden="true">
    <canvas class="orb-wave-canvas" id="orbWaveCanvas" width="140" height="140"></canvas>
  </div>

  <!-- Desktop Expanding Pill Navigation (Desktop Only: min-width 901px) -->
  <aside class="desktop-pill-nav" id="desktopPillNav" aria-label="Main Navigation">
    <!-- Circle Bulb Trigger Button (Always visible on left) -->
    <button class="pill-bulb-btn" id="pillBulbBtn" aria-label="Open Navigation Menu" aria-expanded="false" title="Menu">
      <img src="/assets/bulb-black.png" alt="Davidson Smart Solutions Logo" class="pill-bulb-icon bulb-icon-dark" />
      <img src="/assets/bulb-white.png" alt="Davidson Smart Solutions Commercial Logo" class="pill-bulb-icon bulb-icon-light" />
    </button>

    <!-- Expanded Long Pill Content Wrapper -->
    <div class="pill-content" id="pillContent">
      <div class="pill-divider" aria-hidden="true"></div>

      <nav class="pill-nav-links" aria-label="Desktop Menu">
        {% include "components/nav-links.njk" %}
      </nav>

      <div class="pill-divider" aria-hidden="true"></div>

      <div class="pill-actions">
        <a href="/contact/" class="btn btn-primary pill-btn-consult">Book Consultation</a>
        {% if page.url == "/business/" or isBusinessPage %}
        <a href="/" class="link-arrow pill-switch-link">Residential <i class="fa-solid fa-arrow-right"></i></a>
        {% else %}
        <a href="/business/" class="link-arrow pill-switch-link">Commercial <i class="fa-solid fa-arrow-right"></i></a>
        {% endif %}
      </div>

      <!-- Close Trigger Button on the right of the pill -->
      <button class="pill-close-btn" id="pillCloseBtn" aria-label="Close Navigation Menu" title="Close Menu">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>
  </aside>

  <!-- Mobile Navigation Header (Mobile Only: max-width 900px) -->
  <header class="site-header" id="top">
    <div class="container header-inner">
      {% if isBusinessPage or page.url == "/business/" %}
      <a href="/business/" class="brand-logo" aria-label="Davidson Smart Solutions Commercial Division">
        <img src="/assets/davidson-logo.png" alt="Davidson Smart Solutions Logo" class="nav-brand-logo-img" />
      </a>
      {% else %}
      <a href="/" class="brand-logo" aria-label="Davidson Smart Solutions Home">
        <img src="/assets/davidson-logo.png" alt="Davidson Smart Solutions Logo" class="nav-brand-logo-img" />
      </a>
      {% endif %}

      <nav class="main-nav" id="mainNav">
        {% include "components/nav-links.njk" %}

        <!-- Mobile Action Links Inside Menu Drawer -->
        <div class="mobile-actions-wrapper">
          <a href="/contact/" class="btn btn-primary" style="width: 100%;">Book Consultation</a>
          {% if page.url == "/business/" or isBusinessPage %}
          <a href="/" class="link-arrow" style="margin-top: 0.75rem;">Residential <i
              class="fa-solid fa-arrow-right"></i></a>
          {% else %}
          <a href="/business/" class="link-arrow" style="margin-top: 0.75rem;">Commercial <i
              class="fa-solid fa-arrow-right"></i></a>
          {% endif %}
        </div>
      </nav>

      <div class="header-actions">
        <button class="mobile-toggle" id="mobileToggle" aria-label="Toggle navigation">
          <span class="hamburger-box">
            <span class="hamburger-line line-top"></span>
            <span class="hamburger-line line-bottom"></span>
          </span>
        </button>
      </div>
    </div>
  </header>

  <!-- Main Content -->
  <main id="main-content">
    {{ content | safe }}
  </main>

  <!-- Editorial Footer -->
  <footer class="site-footer">
    <div class="container">
      <div class="footer-grid">
        <div>
          <a href="/" class="brand-logo" style="margin-bottom: 1.25rem; display: inline-block;">
            <img src="/assets/Quinte-Smart-Homes-logo.png" alt="Davidson Smart Solutions Logo"
              style="height: 60px; width: auto; max-width: 240px; object-fit: contain; filter: brightness(0) invert(1);" />
          </a>
          <p style="font-size: 0.9rem; line-height: 1.7; margin-bottom: 1.5rem; color: #a3a3a3; max-width: 340px;">
            Premier electrical and home technology firm. Whole home automation, Lutron lighting, audio/visual
            engineering, and enterprise security installed by master electricians.
          </p>
        </div>

        <div class="footer-col">
          <h4>Sitemap</h4>
          <ul class="footer-links">
            <li><a href="/">Home</a></li>
            <li><a href="/portfolio/">Portfolio</a></li>
            <li><a href="/about/">About Firm</a></li>
            <li><a href="/services/">Services Overview</a></li>
            <li><a href="/industry-professionals/">Contractors & Designers</a></li>
            <li><a href="/#faq">FAQ</a></li>
            <li><a href="/blog/">News & Insights</a></li>
            <li><a href="/contact/">Contact & Consultation</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h4>Strategies</h4>
          <ul class="footer-links">
            <li><a href="/services/smart-lights/">Smart Lighting & Shades</a></li>
            <li><a href="/services/home-theatre/">Audio & Home Theatre</a></li>
            <li><a href="/services/security/">Security & Access Control</a></li>
            <li><a href="/services/networking/">Networking & Starlink</a></li>
            <li><a href="/services/outdoor/">Motorized Screens & Pergolas</a></li>
            <li><a href="/services/commercial/">Commercial Smart Solutions</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h4>Contact</h4>
          <ul class="footer-links">
            <li><i class="fa-solid fa-phone" style="color: var(--color-accent); margin-right: 0.5rem;"></i> {{
              site.phone }}</li>
            <li><i class="fa-solid fa-envelope" style="color: var(--color-accent); margin-right: 0.5rem;"></i> {{
              site.email }}</li>
            <li><i class="fa-solid fa-location-dot" style="color: var(--color-accent); margin-right: 0.5rem;"></i> {{
              site.address }}</li>
            <li><i class="fa-solid fa-certificate" style="color: var(--color-gold); margin-right: 0.5rem;"></i> Davidson
              Electrical Services</li>
          </ul>
        </div>
      </div>

      <div class="footer-bottom">
        <p>© 2026 Davidson Smart Solutions Inc. All Rights Reserved.</p>
        <div style="display: flex; gap: 1.5rem;">
          <a href="/privacy-policy/" style="color: #a3a3a3;">Privacy Policy</a>
          <a href="/terms-of-service/" style="color: #a3a3a3;">Terms of Service</a>
        </div>
      </div>
    </div>
  </footer>

  <!-- Google Preferred Badge Component -->
  <div class="google-badge-fixed-wrapper">
    {% include "components/preferred-badge.njk" %}
  </div>

  <!-- Scripts: Desktop Expanding Pill, Mobile Hamburger, Word Writing Reveal & Stat Count-Up -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // Desktop Expanding Pill Navbar Interaction
      const desktopPill = document.getElementById('desktopPillNav');
      const pillBulbBtn = document.getElementById('pillBulbBtn');
      const pillCloseBtn = document.getElementById('pillCloseBtn');
      const pillThinkingOrb = document.getElementById('pillThinkingOrb');

      if (desktopPill && pillBulbBtn) {
        let expandTimer = null;

        const openDesktopPill = () => {
          clearTimeout(expandTimer);
          if (pillThinkingOrb) pillThinkingOrb.classList.add('is-hidden');
          desktopPill.classList.add('is-expanded');
          pillBulbBtn.setAttribute('aria-expanded', 'true');
          pillBulbBtn.setAttribute('aria-label', 'Close Navigation Menu');
          pillBulbBtn.title = 'Close Menu';
          // Enable overflow once expansion animation finishes so mega-dropdown menus are unclipped
          expandTimer = setTimeout(() => {
            if (desktopPill.classList.contains('is-expanded')) {
              desktopPill.classList.add('overflow-visible');
            }
          }, 460);
        };

        const closeDesktopPill = () => {
          clearTimeout(expandTimer);
          if (pillThinkingOrb) pillThinkingOrb.classList.remove('is-hidden');
          desktopPill.classList.remove('overflow-visible');
          desktopPill.classList.remove('is-expanded');
          pillBulbBtn.setAttribute('aria-expanded', 'false');
          pillBulbBtn.setAttribute('aria-label', 'Open Navigation Menu');
          pillBulbBtn.title = 'Menu';
        };

        pillBulbBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          if (desktopPill.classList.contains('is-expanded')) {
            closeDesktopPill();
          } else {
            openDesktopPill();
          }
        });

        if (pillCloseBtn) {
          pillCloseBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            closeDesktopPill();
          });
        }

        // Close when clicking anywhere outside of the pill
        document.addEventListener('click', (e) => {
          if (desktopPill.classList.contains('is-expanded') && !desktopPill.contains(e.target)) {
            closeDesktopPill();
          }
        });

        // Close on Escape key
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && desktopPill.classList.contains('is-expanded')) {
            closeDesktopPill();
            pillBulbBtn.focus();
          }
        });

        // Auto-close on in-page anchor navigation
        desktopPill.querySelectorAll('a[href^="#"], a[href*="/#"]').forEach(link => {
          link.addEventListener('click', () => {
            setTimeout(closeDesktopPill, 160);
          });
        });

        // Radial Waveform Equalizer Ring Animation Controller
        const orbCanvas = document.getElementById('orbWaveCanvas');
        if (orbCanvas) {
          const ctx = orbCanvas.getContext('2d');
          const dpr = window.devicePixelRatio || 1;
          const size = 140;
          orbCanvas.width = size * dpr;
          orbCanvas.height = size * dpr;
          ctx.scale(dpr, dpr);

          const N = 48; // 48 radial tick capsules like reference animation
          const cx = 70;
          const cy = 70;
          const baseRadius = 41.5; // Sits just outside the 78px circle (radius 39px)
          let time = 0;
          let targetEnergy = 1.0;
          let currentEnergy = 1.0;
          let animId = null;

          desktopPill.addEventListener('mouseenter', () => {
            if (!desktopPill.classList.contains('is-expanded')) {
              targetEnergy = 1.35;
            }
          });
          desktopPill.addEventListener('mouseleave', () => {
            targetEnergy = 1.0;
          });

          let colorBlend = 1.0; // 1 = dark section (amber-gold), 0 = light section (navy + gold accent)

          const lerpColor = (c1, c2, factor) => {
            const r = Math.round(c1[0] + (c2[0] - c1[0]) * factor);
            const g = Math.round(c1[1] + (c2[1] - c1[1]) * factor);
            const b = Math.round(c1[2] + (c2[2] - c1[2]) * factor);
            return `rgb(${r}, ${g}, ${b})`;
          };

          // Business Navbar Consultation Button Blue (#4a577d -> #61709e)
          const blueInner = [74, 87, 125];      // Business Button Slate (#4a577d)
          const blueOuter = [104, 120, 170];    // Business Button Accent Blue (#61709e luminous tint)
          const goldBase = [197, 160, 89];      // Signature Gold (#C5A059)
          const brightGold = [255, 224, 138];   // Radiant Amber Gold Highlight (#ffe08a)

          const drawWave = () => {
            if (window.innerWidth <= 900 || desktopPill.classList.contains('is-expanded')) {
              animId = requestAnimationFrame(drawWave);
              return;
            }

            ctx.clearRect(0, 0, size, size);
            currentEnergy += (targetEnergy - currentEnergy) * 0.08;
            time += 0.026 * currentEnergy;

            // Smooth color transition based on section background
            const targetBlend = desktopPill.classList.contains('is-on-dark') ? 1.0 : 0.0;
            colorBlend += (targetBlend - colorBlend) * 0.08;

            const currentInnerColor = lerpColor(blueInner, goldBase, colorBlend);
            const currentOuterColor = lerpColor(blueOuter, brightGold, colorBlend);

            ctx.lineWidth = 2.4;
            ctx.lineCap = 'round';

            for (let i = 0; i < N; i++) {
              const theta = i * (2 * Math.PI / N);

              // Multi-harmonic undulating wave traveling along circumference
              const w1 = Math.sin(theta * 3 - time * 2.0);
              const w2 = Math.sin(theta * 5 + time * 1.5);
              const w3 = Math.cos(theta * 2 - time * 0.85);
              const mod = 0.65 + 0.35 * Math.sin(theta * 2 + time * 1.1);

              const rawWave = ((w1 * 0.55 + w2 * 0.3 + w3 * 0.15) + 1) * 0.5; // 0 to 1
              const waveHeight = (2.2 + rawWave * 6.8 * mod) * currentEnergy;

              // Subtle organic base breathing
              const baseWobble = Math.sin(theta * 2 - time * 0.75) * 0.8 * currentEnergy;
              const rInner = baseRadius + baseWobble;
              const rOuter = rInner + waveHeight;

              const cos = Math.cos(theta);
              const sin = Math.sin(theta);

              const x1 = cx + cos * rInner;
              const y1 = cy + sin * rInner;
              const x2 = cx + cos * rOuter;
              const y2 = cy + sin * rOuter;

              // Volumetric luminescence pulse: solid on light sections, luminous on dark
              const baseAlpha = 0.85 - colorBlend * 0.13;
              ctx.globalAlpha = baseAlpha + rawWave * (1 - baseAlpha);

              // Dynamic wave gradient based on background luminance
              const grad = ctx.createLinearGradient(x1, y1, x2, y2);
              grad.addColorStop(0, currentInnerColor);
              grad.addColorStop(1, currentOuterColor);

              ctx.beginPath();
              ctx.moveTo(x1, y1);
              ctx.lineTo(x2, y2);
              ctx.strokeStyle = grad;
              ctx.stroke();
            }

            animId = requestAnimationFrame(drawWave);
          };

          animId = requestAnimationFrame(drawWave);
        }

        // Dynamic Section Theme Detector (Black vs White Bulb)
        let themeScrollTicking = false;
        const updateBulbTheme = () => {
          if (desktopPill.classList.contains('is-expanded')) return;

          const btnRect = pillBulbBtn.getBoundingClientRect();
          const testX = btnRect.left + btnRect.width / 2;
          const testY = btnRect.top + btnRect.height / 2;

          let isDark = false;

          // Check elements under floating button center
          if (typeof document.elementsFromPoint === 'function') {
            const elements = document.elementsFromPoint(testX, testY);
            for (const el of elements) {
              if (el === desktopPill || desktopPill.contains(el) || el === orbCanvas || (pillThinkingOrb && pillThinkingOrb.contains(el))) {
                continue;
              }

              // Explicit dark section selectors
              if (
                el.closest('.hero-editorial') ||
                el.closest('.hero-editorial-business') ||
                el.closest('.site-footer') ||
                el.closest('.footer-editorial') ||
                el.closest('.footer-bottom') ||
                el.closest('.bg-dark') ||
                el.closest('.dark-section') ||
                el.closest('[data-theme="dark"]')
              ) {
                isDark = true;
                break;
              }

              // Check computed background color luminance
              const style = window.getComputedStyle(el);
              const bg = style.backgroundColor;
              if (bg && bg !== 'transparent' && !bg.startsWith('rgba(0, 0, 0, 0)')) {
                const match = bg.match(/rgba?\((\d+),\s*(\d+),\s*(\d+)/);
                if (match) {
                  const r = parseInt(match[1], 10);
                  const g = parseInt(match[2], 10);
                  const b = parseInt(match[3], 10);
                  const lum = 0.299 * r + 0.587 * g + 0.114 * b;
                  isDark = lum < 135;
                  break;
                }
              }
            }
          }

          // Fallback for top hero on index (residential) and commercial portal
          if (!isDark && window.scrollY < 650) {
            const topHero = document.querySelector('.hero-editorial, .hero-editorial-business');
            if (topHero && topHero.getBoundingClientRect().bottom > btnRect.top + 20) {
              isDark = true;
            }
          }

          if (isDark) {
            desktopPill.classList.add('is-on-dark');
            desktopPill.classList.remove('is-on-light');
          } else {
            desktopPill.classList.add('is-on-light');
            desktopPill.classList.remove('is-on-dark');
          }
        };

        window.addEventListener('scroll', () => {
          if (!themeScrollTicking) {
            requestAnimationFrame(() => {
              updateBulbTheme();
              themeScrollTicking = false;
            });
            themeScrollTicking = true;
          }
        }, { passive: true });

        window.addEventListener('resize', updateBulbTheme, { passive: true });
        updateBulbTheme();
      }

      // Mobile Toggle with Smooth Hamburger-to-X Transition
      const toggleBtn = document.getElementById('mobileToggle');
      const mainNav = document.getElementById('mainNav');

      if (toggleBtn && mainNav) {
        const closeMobileNav = () => {
          mainNav.classList.remove('mobile-active');
          toggleBtn.classList.remove('active');
          mainNav.querySelectorAll('.has-dropdown.dropdown-open').forEach(el => {
            el.classList.remove('dropdown-open');
            const l = el.querySelector('.nav-link');
            if (l) l.blur();
          });
        };

        toggleBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          const isActive = mainNav.classList.contains('mobile-active');
          if (isActive) {
            closeMobileNav();
          } else {
            mainNav.classList.add('mobile-active');
            toggleBtn.classList.add('active');
          }
        });

        // Close mobile nav when clicking outside
        document.addEventListener('click', (e) => {
          if (mainNav.classList.contains('mobile-active') && !mainNav.contains(e.target) && !toggleBtn.contains(e.target)) {
            closeMobileNav();
          }
        });

        // Handle link clicks inside mobile navigation
        mainNav.querySelectorAll('a').forEach(link => {
          let handledByTouch = false;

          const handleToggle = (e) => {
            const parentDropdown = link.closest('.has-dropdown');
            const isParentHeaderLink = parentDropdown && parentDropdown.querySelector('.nav-link') === link;

            if (window.innerWidth <= 900 && isParentHeaderLink) {
              e.preventDefault();
              e.stopPropagation();

              const toggleState = () => {
                const isOpen = parentDropdown.classList.toggle('dropdown-open');
                if (!isOpen) {
                  link.blur();
                }
              };

              if (e.type === 'pointerdown' || e.type === 'touchstart') {
                handledByTouch = true;
                toggleState();
              } else if (e.type === 'click') {
                if (handledByTouch) {
                  handledByTouch = false;
                  return;
                }
                toggleState();
              }
            } else if (e.type === 'click') {
              closeMobileNav();
            }
          };

          link.addEventListener('pointerdown', handleToggle, { passive: false });
          link.addEventListener('click', handleToggle);
        });
      }

      // Scroll-Driven Word Writing Reveal Effect (HTML Preserving)
      const revealContainers = document.querySelectorAll('.scroll-text-reveal');
      revealContainers.forEach(container => {
        function processNode(node) {
          if (node.nodeType === Node.TEXT_NODE) {
            const text = node.textContent;
            if (!text.trim()) return node;
            const words = text.split(/(\s+)/);
            const fragment = document.createDocumentFragment();
            words.forEach(w => {
              if (/^\s+$/.test(w)) {
                fragment.appendChild(document.createTextNode(w));
              } else if (w) {
                const span = document.createElement('span');
                span.className = 'scroll-word';
                span.textContent = w;
                fragment.appendChild(span);
              }
            });
            return fragment;
          } else if (node.nodeType === Node.ELEMENT_NODE) {
            Array.from(node.childNodes).forEach(child => {
              const replacement = processNode(child);
              if (replacement && replacement !== child) {
                node.replaceChild(replacement, child);
              }
            });
            return node;
          }
        }

        processNode(container);
        const wordSpans = container.querySelectorAll('.scroll-word');

        function updateWordsOnScroll() {
          const rect = container.getBoundingClientRect();
          const windowHeight = window.innerHeight;

          const startThreshold = windowHeight * 0.85;
          const endThreshold = windowHeight * 0.35;

          let progress = (startThreshold - rect.top) / (startThreshold - endThreshold);
          progress = Math.max(0, Math.min(1, progress));

          const activeIndex = Math.floor(progress * (wordSpans.length + 1));

          wordSpans.forEach((span, index) => {
            if (index < activeIndex) {
              span.classList.add('active');
            } else {
              span.classList.remove('active');
            }
          });
        }

        window.addEventListener('scroll', updateWordsOnScroll, { passive: true });
        updateWordsOnScroll();
      });

      // Global Stat Number Count-Up Animation Function
      window.animateSingleCount = function (el, durationOverride) {
        if (!el || el.dataset.hasAnimated === 'true') return;
        el.dataset.hasAnimated = 'true';

        const target = parseFloat(el.getAttribute('data-target') || '0');
        const prefix = el.getAttribute('data-prefix') || '';
        const suffix = el.getAttribute('data-suffix') || '';
        const decimals = parseInt(el.getAttribute('data-decimals') || '0', 10);
        const duration = durationOverride || 1800;
        const startTime = performance.now();

        function updateCount(now) {
          const elapsed = now - startTime;
          const progress = Math.min(elapsed / duration, 1);
          const easeOutProgress = 1 - Math.pow(1 - progress, 3);
          const currentVal = easeOutProgress * target;

          if (decimals > 0) {
            el.innerHTML = `${prefix}${currentVal.toFixed(decimals)}${suffix}`;
          } else {
            el.innerHTML = `${prefix}${Math.floor(currentVal).toLocaleString()}${suffix}`;
          }

          if (progress < 1) {
            requestAnimationFrame(updateCount);
          } else {
            if (decimals > 0) {
              el.innerHTML = `${prefix}${target.toFixed(decimals)}${suffix}`;
            } else {
              el.innerHTML = `${prefix}${target.toLocaleString()}${suffix}`;
            }
          }
        }

        requestAnimationFrame(updateCount);
      };

      const countElements = document.querySelectorAll('.stat-count:not([data-manual-count="true"])');
      if (countElements.length > 0) {
        const countObserver = new IntersectionObserver((entries, obs) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              const el = entry.target;
              if (!el.closest('.specialty-stat-item')) {
                window.animateSingleCount(el);
                obs.unobserve(el);
              }
            }
          });
        }, { threshold: 0.2 });

        countElements.forEach(el => {
          if (!el.closest('.specialty-stat-item')) {
            countObserver.observe(el);
          }
        });
      }

      // Desktop Staggered Stat Box Scroll Parallax Fallback
      if (window.innerWidth > 900 && !CSS.supports('(animation-timeline: view()) and (animation-range: entry)')) {
        const container = document.querySelector('.staggered-cards-container');
        const rightCol = document.querySelector('.staggered-col-right');
        if (container && rightCol) {
          let ticking = false;
          const updateParallax = () => {
            if (window.innerWidth <= 900) return;
            const rect = container.getBoundingClientRect();
            const windowHeight = window.innerHeight;
            if (rect.bottom >= 0 && rect.top <= windowHeight) {
              const totalDist = windowHeight + rect.height;
              const progress = (windowHeight - rect.top) / totalDist;
              const clamped = Math.max(0, Math.min(1, progress));
              const translateY = 130 - clamped * 260;
              rightCol.style.transform = `translateY(${translateY}px)`;
            }
            ticking = false;
          };
          window.addEventListener('scroll', () => {
            if (!ticking) {
              requestAnimationFrame(updateParallax);
              ticking = true;
            }
          }, { passive: true });
          updateParallax();
        }
      }

      // Title Color Wipe Reveal Observer (Faded to Full Color Left-to-Right)
      const colorWipeElements = document.querySelectorAll('.title-color-wipe');
      if (colorWipeElements.length > 0) {
        if ('IntersectionObserver' in window) {
          const colorWipeObserver = new IntersectionObserver((entries, obs) => {
            entries.forEach(entry => {
              if (entry.isIntersecting) {
                entry.target.classList.add('revealed');
                obs.unobserve(entry.target);
              }
            });
          }, { threshold: 0.15, rootMargin: '0px 0px -50px 0px' });

          colorWipeElements.forEach(el => colorWipeObserver.observe(el));
        } else {
          colorWipeElements.forEach(el => el.classList.add('revealed'));
        }
      }

      // Rewired List Items Bottom-Up Staggered Reveal Observer
      const rewiredItems = document.querySelectorAll('.rewired-list-item');
      if (rewiredItems.length > 0) {
        if ('IntersectionObserver' in window) {
          const rewiredObserver = new IntersectionObserver((entries, obs) => {
            entries.forEach(entry => {
              if (entry.isIntersecting) {
                entry.target.classList.add('revealed');
                obs.unobserve(entry.target);
              }
            });
          }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });

          rewiredItems.forEach(item => rewiredObserver.observe(item));
        } else {
          rewiredItems.forEach(item => item.classList.add('revealed'));
        }
      }

      // Process Cards Bottom-Up Staggered Reveal Observer
      const processCards = document.querySelectorAll('.process-card-featured, .process-card-secondary');
      const processGrid = document.querySelector('.process-cards-grid');
      if (processCards.length > 0) {
        if ('IntersectionObserver' in window) {
          if (window.innerWidth > 991 && processGrid) {
            const gridObserver = new IntersectionObserver((entries, obs) => {
              entries.forEach(entry => {
                if (entry.isIntersecting) {
                  processCards.forEach(card => card.classList.add('revealed'));
                  obs.unobserve(entry.target);
                }
              });
            }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });

            gridObserver.observe(processGrid);
          } else {
            const cardObserver = new IntersectionObserver((entries, obs) => {
              entries.forEach(entry => {
                if (entry.isIntersecting) {
                  entry.target.classList.add('revealed');
                  obs.unobserve(entry.target);
                }
              });
            }, { threshold: 0.15, rootMargin: '0px 0px -30px 0px' });

            processCards.forEach(card => cardObserver.observe(card));
          }
        } else {
          processCards.forEach(card => card.classList.add('revealed'));
        }
      }

      // Brand Staggered Grid Scroll Reveal Observer
      const brandGrid = document.querySelector('.brand-staggered-grid');
      if (brandGrid) {
        if ('IntersectionObserver' in window) {
          const brandObserver = new IntersectionObserver((entries, obs) => {
            entries.forEach(entry => {
              if (entry.isIntersecting) {
                entry.target.classList.add('revealed');
                obs.unobserve(entry.target);
              }
            });
          }, { threshold: 0.1, rootMargin: '0px 0px -30px 0px' });
          brandObserver.observe(brandGrid);
        } else {
          brandGrid.classList.add('revealed');
        }
      }
    });
  </script>
</body>

</html>