  </footer>

  <!-- Google Preferred Badge Component -->
  <div class="google-badge-fixed-wrapper">
    {% include "components/preferred-badge.njk" %}
  </div>

  <!-- Scripts: Desktop Expanding Pill, Mobile Hamburger, Word Writing Reveal & Stat Count-Up -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // 1. Mobile Floating Dark Glass Island Controls
      const mobileIslandHeader = document.getElementById('mobileIslandHeader');
      const mobileIslandDropdown = document.getElementById('mobileIslandDropdown');
      const mobileIslandToggle = document.getElementById('mobileIslandToggle');
      const mobileIslandBulbBtn = document.getElementById('mobileIslandBulbBtn');
      const mobileIslandBackdrop = document.getElementById('mobileIslandBackdrop');
      const drawerAboutToggle = document.getElementById('drawerAboutToggle');
      const drawerAboutMenu = document.getElementById('drawerAboutMenu');

      const openMobileIsland = () => {
        if (!mobileIslandDropdown) return;
        if (mobileIslandHeader) mobileIslandHeader.classList.add('is-open');
        mobileIslandDropdown.classList.add('active');
        mobileIslandDropdown.setAttribute('aria-hidden', 'false');
        if (mobileIslandToggle) {
          mobileIslandToggle.classList.add('active');
          mobileIslandToggle.setAttribute('aria-expanded', 'true');
        }
        if (mobileIslandBulbBtn) mobileIslandBulbBtn.setAttribute('aria-expanded', 'true');
        if (mobileIslandBackdrop) mobileIslandBackdrop.classList.add('active');
        document.body.style.overflow = 'hidden';
      };

      const closeMobileIsland = () => {
        if (!mobileIslandDropdown) return;
        if (mobileIslandHeader) mobileIslandHeader.classList.remove('is-open');
        mobileIslandDropdown.classList.remove('active');
        mobileIslandDropdown.setAttribute('aria-hidden', 'true');
        if (mobileIslandToggle) {
          mobileIslandToggle.classList.remove('active');
          mobileIslandToggle.setAttribute('aria-expanded', 'false');
        }
        if (mobileIslandBulbBtn) mobileIslandBulbBtn.setAttribute('aria-expanded', 'false');
        if (mobileIslandBackdrop) mobileIslandBackdrop.classList.remove('active');
        document.body.style.overflow = '';

        document.querySelectorAll('.drawer-has-sub.open').forEach(row => {
          row.classList.remove('open');
          const toggle = row.querySelector('.drawer-sub-toggle');
          if (toggle) toggle.setAttribute('aria-expanded', 'false');
          const sub = row.querySelector('.drawer-sub-menu');
          if (sub) {
            sub.style.maxHeight = '0px';
            sub.style.opacity = '0';
          }
        });

        const scrollContainer = mobileIslandDropdown.querySelector('.island-dropdown-scroll');
        if (scrollContainer) {
          setTimeout(() => {
            if (mobileIslandHeader && !mobileIslandHeader.classList.contains('is-open')) {
              scrollContainer.scrollTop = 0;
            }
          }, 450);
        }
      };

      if (mobileIslandToggle) {
        mobileIslandToggle.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          if (mobileIslandDropdown && mobileIslandDropdown.classList.contains('active')) {
            closeMobileIsland();
          } else {
            openMobileIsland();
          }
        });
      }

      if (mobileIslandBulbBtn) {
        mobileIslandBulbBtn.addEventListener('click', (e) => {
          const targetHref = mobileIslandBulbBtn.getAttribute('href');
          const currentPath = window.location.pathname;
          const isAtHome = (targetHref === currentPath) ||
                           (targetHref === '/' && (currentPath === '' || currentPath === '/index.html' || currentPath === '/')) ||
                           (targetHref === '/business/' && (currentPath === '/business' || currentPath === '/business/index.html' || currentPath === '/business/'));

          if (isAtHome) {
            e.preventDefault();
            if (mobileIslandDropdown && mobileIslandDropdown.classList.contains('active')) {
              closeMobileIsland();
            }
            window.scrollTo({ top: 0, behavior: 'smooth' });
          } else {
            if (mobileIslandDropdown && mobileIslandDropdown.classList.contains('active')) {
              closeMobileIsland();
            }
          }
        });
      }

      if (mobileIslandBackdrop) {
        mobileIslandBackdrop.addEventListener('click', (e) => {
          e.preventDefault();
          closeMobileIsland();
        });
      }

      // Close on Escape key
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && mobileIslandDropdown && mobileIslandDropdown.classList.contains('active')) {
          closeMobileIsland();
        }
      });

      // Smooth Accordion for Dropdowns (Services, About, etc.) inside Drawer
      const drawerSubToggles = document.querySelectorAll('.drawer-sub-toggle');
      drawerSubToggles.forEach((toggleBtn) => {
        const parentRow = toggleBtn.closest('.drawer-has-sub');
        const subMenu = parentRow ? parentRow.querySelector('.drawer-sub-menu') : null;
        if (!subMenu) return;

        toggleBtn.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
          const nextState = !isExpanded;

          toggleBtn.setAttribute('aria-expanded', String(nextState));
          if (parentRow) {
            parentRow.classList.toggle('open', nextState);
          }
          if (nextState) {
            subMenu.style.maxHeight = subMenu.scrollHeight + 30 + 'px';
            subMenu.style.opacity = '1';
          } else {
            subMenu.style.maxHeight = '0px';
            subMenu.style.opacity = '0';
          }
        });
      });

      // Close drawer on click of navigation links
      const drawerNavLinks = document.querySelectorAll('.drawer-top-switch-wrap a, .drawer-editorial-nav a, .drawer-services-cards a, .island-right-group a, .drawer-footer-brand a');
      drawerNavLinks.forEach((link) => {
        link.addEventListener('click', () => {
          setTimeout(() => {
            closeMobileIsland();
          }, 120);
        });
      });

      // 2. Desktop Expanding Pill Navbar Controls
      const desktopPill = document.getElementById('desktopPillNav');
      const pillBulbBtn = document.getElementById('pillBulbBtn');
      const pillCloseBtn = document.getElementById('pillCloseBtn');
      const pillThinkingOrb = document.getElementById('pillThinkingOrb');

      if (desktopPill && pillBulbBtn) {
        let expandTimer = null;

        const openDesktopPill = () => {
          clearTimeout(expandTimer);
          if (pillThinkingOrb) pillThinkingOrb.classList.add('is-hidden');
          desktopPill.classList.add('is-expanded');
          pillBulbBtn.setAttribute('aria-expanded', 'true');
          pillBulbBtn.setAttribute('aria-label', 'Close Navigation Menu');
          pillBulbBtn.title = 'Close Menu';
          expandTimer = setTimeout(() => {
            if (desktopPill.classList.contains('is-expanded')) {
              desktopPill.classList.add('overflow-visible');
            }
          }, 460);
        };

        const closeDesktopPill = () => {
          clearTimeout(expandTimer);
          if (pillThinkingOrb) pillThinkingOrb.classList.remove('is-hidden');
          desktopPill.classList.remove('overflow-visible');
          desktopPill.classList.remove('is-expanded');
          pillBulbBtn.setAttribute('aria-expanded', 'false');
          pillBulbBtn.setAttribute('aria-label', 'Open Navigation Menu');
          pillBulbBtn.title = 'Menu';
        };

        pillBulbBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          if (desktopPill.classList.contains('is-expanded')) {
            closeDesktopPill();
          } else {
            openDesktopPill();
          }
        });

        if (pillCloseBtn) {
          pillCloseBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            closeDesktopPill();
          });
        }

        document.addEventListener('click', (e) => {
          if (desktopPill.classList.contains('is-expanded') && !desktopPill.contains(e.target)) {
            closeDesktopPill();
          }
        });
      }

      // Escape Key Dismissal (Both Desktop & Mobile)
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          if (desktopPill && desktopPill.classList.contains('is-expanded')) {
            desktopPill.classList.remove('is-expanded', 'overflow-visible');
            if (pillThinkingOrb) pillThinkingOrb.classList.remove('is-hidden');
            if (pillBulbBtn) {
              pillBulbBtn.setAttribute('aria-expanded', 'false');
              pillBulbBtn.focus();
            }
          }
          if (mobileIslandDropdown && mobileIslandDropdown.classList.contains('active')) {
            closeMobileIsland();
            if (mobileIslandToggle) mobileIslandToggle.focus();
          }
        }
      });

      // Auto-close on in-page navigation
      document.querySelectorAll('.mobile-island-dropdown a:not(.island-sub-toggle), .desktop-pill-nav a').forEach(link => {
        link.addEventListener('click', () => {
          setTimeout(() => {
            if (desktopPill && desktopPill.classList.contains('is-expanded')) {
              desktopPill.classList.remove('is-expanded', 'overflow-visible');
              if (pillThinkingOrb) pillThinkingOrb.classList.remove('is-hidden');
            }
            closeMobileIsland();
          }, 180);
        });
      });

      // 3. Radial Waveform Equalizer Ring Animation Controller (Desktop & Mobile)
      const desktopCanvas = document.getElementById('orbWaveCanvas');
      const mobileCanvas = document.getElementById('mobileOrbWaveCanvas');
      const drawerCanvas = document.getElementById('drawerOrbWaveCanvas');

      const activeCanvases = [];
      const initCanvas = (canvas, isMobile) => {
        if (!canvas) return;
        const ctx = canvas.getContext('2d');
        const dpr = window.devicePixelRatio || 1;
        const size = 140;
        canvas.width = size * dpr;
        canvas.height = size * dpr;
        ctx.scale(dpr, dpr);
        activeCanvases.push({ canvas, ctx, isMobile });
      };
      initCanvas(desktopCanvas, false);
      initCanvas(mobileCanvas, true);
      initCanvas(drawerCanvas, true);

      const N = 48; // 48 radial tick capsules like reference animation
      const cx = 70;
      const cy = 70;
      const baseRadius = 41.5;
      let time = 0;
      let targetEnergy = 1.0;
      let currentEnergy = 1.0;
      let animId = null;

      if (desktopPill) {
        desktopPill.addEventListener('mouseenter', () => {
          if (!desktopPill.classList.contains('is-expanded')) {
            targetEnergy = 1.35;
          }
        });
        desktopPill.addEventListener('mouseleave', () => {
          targetEnergy = 1.0;
        });
      }

      if (mobileIslandBulbBtn) {
        mobileIslandBulbBtn.addEventListener('touchstart', () => {
          targetEnergy = 1.35;
        }, { passive: true });
        mobileIslandBulbBtn.addEventListener('touchend', () => {
          setTimeout(() => { targetEnergy = 1.0; }, 350);
        }, { passive: true });
      }

      const drawerBrandLink = document.querySelector('.drawer-brand-logo-link');
      if (drawerBrandLink) {
        drawerBrandLink.addEventListener('touchstart', () => {
          targetEnergy = 1.35;
        }, { passive: true });
        drawerBrandLink.addEventListener('touchend', () => {
          setTimeout(() => { targetEnergy = 1.0; }, 350);
        }, { passive: true });
      }

      let desktopColorBlend = 1.0;
      let mobileColorBlend = 1.0;

      const lerpColor = (c1, c2, factor) => {
        const r = Math.round(c1[0] + (c2[0] - c1[0]) * factor);
        const g = Math.round(c1[1] + (c2[1] - c1[1]) * factor);
        const b = Math.round(c1[2] + (c2[2] - c1[2]) * factor);
        return 'rgb(' + r + ', ' + g + ', ' + b + ')';
      };

      const blueInner = [74, 87, 125];
      const blueOuter = [104, 120, 170];
      const mobileBlueInner = [97, 112, 158]; // #61709e signature business CTA slate blue
      const mobileBlueOuter = [123, 140, 184]; // #7b8cb8 radiant commercial accent aura
      const goldBase = [197, 160, 89];
      const brightGold = [255, 224, 138];

      // Light Blue Palette for Business pages and services
      const bizLightBlueInner = [115, 155, 225]; // Radiant light cornflower blue
      const bizLightBlueOuter = [175, 218, 255]; // Luminous sky light blue tips
      const bizLightBlueSoftInner = [85, 120, 190];
      const bizLightBlueSoftOuter = [140, 180, 245];

      const drawWave = () => {
        currentEnergy += (targetEnergy - currentEnergy) * 0.08;
        time += 0.026 * currentEnergy;

        // Desktop blend: driven purely by the desktop dynamic section theme detector (is-on-dark)
        const targetDesktopBlend = (desktopPill && desktopPill.classList.contains('is-on-dark')) ? 1.0 : 0.0;
        desktopColorBlend += (targetDesktopBlend - desktopColorBlend) * 0.08;

        // Mobile blend: light blue in Commercial, gold in Residential
        const isBusiness = document.body.classList.contains('business-portal');
        const targetMobileBlend = isBusiness ? 0.0 : 1.0;
        mobileColorBlend += (targetMobileBlend - mobileColorBlend) * 0.08;

        for (const item of activeCanvases) {
          if (item.canvas.getBoundingClientRect().width === 0) continue;
          if (!item.isMobile && desktopPill && desktopPill.classList.contains('is-expanded')) continue;
          if (item.canvas === drawerCanvas && (!mobileIslandDropdown || !mobileIslandDropdown.classList.contains('active'))) continue;

          let currentInnerColor, currentOuterColor;
          const blend = item.isMobile ? mobileColorBlend : desktopColorBlend;

          if (isBusiness) {
            // Business pages and services: radiant light blue
            currentInnerColor = lerpColor(bizLightBlueSoftInner, bizLightBlueInner, blend);
            currentOuterColor = lerpColor(bizLightBlueSoftOuter, bizLightBlueOuter, blend);
          } else {
            // Residential pages: gold when on dark, slate when on light
            const innerColorBase = item.isMobile ? mobileBlueInner : blueInner;
            const outerColorBase = item.isMobile ? mobileBlueOuter : blueOuter;
            currentInnerColor = lerpColor(innerColorBase, goldBase, blend);
            currentOuterColor = lerpColor(outerColorBase, brightGold, blend);
          }

          const ctx = item.ctx;
          ctx.clearRect(0, 0, 140, 140);
          ctx.lineWidth = 2.4;
          ctx.lineCap = 'round';

          for (let i = 0; i < N; i++) {
            const theta = i * (2 * Math.PI / N);
            const w1 = Math.sin(theta * 3 - time * 2.0);
            const w2 = Math.sin(theta * 5 + time * 1.5);
            const w3 = Math.cos(theta * 2 - time * 0.85);
            const mod = 0.65 + 0.35 * Math.sin(theta * 2 + time * 1.1);

            const isDrawer = (item.canvas === drawerCanvas);
            const rawWave = ((w1 * 0.55 + w2 * 0.3 + w3 * 0.15) + 1) * 0.5;
            const baseLen = isDrawer ? 4.8 : 2.2;
            const waveAmp = isDrawer ? 9.2 : 6.8;
            const waveHeight = (baseLen + rawWave * waveAmp * mod) * currentEnergy;

            const baseWobble = Math.sin(theta * 2 - time * 0.75) * 0.8 * currentEnergy;
            const rInner = (baseRadius - (isDrawer ? 1.5 : 0)) + baseWobble;
            const rOuter = rInner + waveHeight;

            const cos = Math.cos(theta);
            const sin = Math.sin(theta);

            // In the drawer logo, remove only the orb lines that overlap directly with the letter 'D'
            if (isDrawer && cos > 0.82) {
              continue;
            }

            const x1 = cx + cos * rInner;
            const y1 = cy + sin * rInner;
            const x2 = cx + cos * rOuter;
            const y2 = cy + sin * rOuter;

            const baseAlpha = isBusiness ? 0.90 : (0.85 - blend * 0.13);
            ctx.globalAlpha = baseAlpha + rawWave * (1 - baseAlpha);

            const grad = ctx.createLinearGradient(x1, y1, x2, y2);
            grad.addColorStop(0, currentInnerColor);
            grad.addColorStop(1, currentOuterColor);

            ctx.beginPath();
            ctx.moveTo(x1, y1);
            ctx.lineTo(x2, y2);
            ctx.strokeStyle = grad;
            ctx.stroke();
          }
        }

        animId = requestAnimationFrame(drawWave);
      };

      animId = requestAnimationFrame(drawWave);

      // 4. Desktop Dynamic Section Theme Detector
      if (desktopPill && pillBulbBtn) {
        let themeScrollTicking = false;
        const updateBulbTheme = () => {
          if (desktopPill.classList.contains('is-expanded')) return;
          const btnRect = pillBulbBtn.getBoundingClientRect();
          const testX = btnRect.left + btnRect.width / 2;
          const testY = btnRect.top + btnRect.height / 2;

          let isDark = false;
          if (typeof document.elementsFromPoint === 'function') {
            const elements = document.elementsFromPoint(testX, testY);
            for (const el of elements) {
              if (el === desktopPill || desktopPill.contains(el) || el === desktopCanvas || (pillThinkingOrb && pillThinkingOrb.contains(el))) {
                continue;
              }
              if (
                el.closest('.hero-editorial') ||
                el.closest('.hero-editorial-business') ||
                el.closest('.site-footer') ||
                el.closest('.footer-editorial') ||
                el.closest('.footer-bottom') ||
                el.closest('.bg-dark') ||
                el.closest('.dark-section') ||
                el.closest('[data-theme="dark"]')
              ) {
                isDark = true;
                break;
              }
              const style = window.getComputedStyle(el);
              const bg = style.backgroundColor;
              if (bg && bg !== 'transparent' && !bg.startsWith('rgba(0, 0, 0, 0)')) {
                const match = bg.match(/rgba?\((\d+),\s*(\d+),\s*(\d+)/);
                if (match) {
                  const r = parseInt(match[1], 10);
                  const g = parseInt(match[2], 10);
                  const b = parseInt(match[3], 10);
                  const lum = 0.299 * r + 0.587 * g + 0.114 * b;
                  isDark = lum < 135;
                  break;
                }
              }
            }
          }

          if (!isDark && window.scrollY < 650) {
            const topHero = document.querySelector('.hero-editorial, .hero-editorial-business');
            if (topHero && topHero.getBoundingClientRect().bottom > btnRect.top + 20) {
              isDark = true;
            }
          }

          if (isDark) {
            desktopPill.classList.add('is-on-dark');
            desktopPill.classList.remove('is-on-light');
          } else {
            desktopPill.classList.add('is-on-light');
            desktopPill.classList.remove('is-on-dark');
          }
        };

        window.addEventListener('scroll', () => {
          if (!themeScrollTicking) {
            requestAnimationFrame(() => {
              updateBulbTheme();
              themeScrollTicking = false;
            });
            themeScrollTicking = true;
          }
        }, { passive: true });

        window.addEventListener('resize', updateBulbTheme, { passive: true });
        updateBulbTheme();
      }

      // Scroll-Driven Word Writing Reveal Effect (HTML Preserving)
      const revealContainers = document.querySelectorAll('.scroll-text-reveal');
      revealContainers.forEach(container => {
        function processNode(node) {
          if (node.nodeType === Node.TEXT_NODE) {
            const text = node.textContent;
            if (!text.trim()) return node;
            const words = text.split(/(\s+)/);
            const fragment = document.createDocumentFragment();
            words.forEach(w => {
              if (/^\s+$/.test(w)) {
                fragment.appendChild(document.createTextNode(w));
              } else if (w) {
                const span = document.createElement('span');
                span.className = 'scroll-word';
                span.textContent = w;
                fragment.appendChild(span);
              }
            });
            return fragment;
          } else if (node.nodeType === Node.ELEMENT_NODE) {
            Array.from(node.childNodes).forEach(child => {
              const replacement = processNode(child);
              if (replacement && replacement !== child) {
                node.replaceChild(replacement, child);
              }
            });
            return node;
          }
        }

        processNode(container);
        const wordSpans = container.querySelectorAll('.scroll-word');

        function updateWordsOnScroll() {
          const rect = container.getBoundingClientRect();
          const windowHeight = window.innerHeight;

          const startThreshold = windowHeight * 0.85;
          const endThreshold = windowHeight * 0.35;

          let progress = (startThreshold - rect.top) / (startThreshold - endThreshold);
          progress = Math.max(0, Math.min(1, progress));

          const activeIndex = Math.floor(progress * (wordSpans.length + 1));

          wordSpans.forEach((span, index) => {
            if (index < activeIndex) {
              span.classList.add('active');
            } else {
              span.classList.remove('active');
            }
          });
        }

        window.addEventListener('scroll', updateWordsOnScroll, { passive: true });
        updateWordsOnScroll();
      });

      // Global Stat Number Count-Up Animation Function
      window.animateSingleCount = function (el, durationOverride) {
        if (!el || el.dataset.hasAnimated === 'true') return;
        el.dataset.hasAnimated = 'true';

        const target = parseFloat(el.getAttribute('data-target') || '0');
        const prefix = el.getAttribute('data-prefix') || '';
        const suffix = el.getAttribute('data-suffix') || '';
        const decimals = parseInt(el.getAttribute('data-decimals') || '0', 10);
        const duration = durationOverride || 1800;
        const startTime = performance.now();

        function updateCount(now) {
          const elapsed = now - startTime;
          const progress = Math.min(elapsed / duration, 1);
          const easeOutProgress = 1 - Math.pow(1 - progress, 3);
          const currentVal = easeOutProgress * target;

          if (decimals > 0) {
            el.innerHTML = `${prefix}${currentVal.toFixed(decimals)}${suffix}`;
          } else {
            el.innerHTML = `${prefix}${Math.floor(currentVal).toLocaleString()}${suffix}`;
          }

          if (progress < 1) {
            requestAnimationFrame(updateCount);
          } else {
            if (decimals > 0) {
              el.innerHTML = `${prefix}${target.toFixed(decimals)}${suffix}`;
            } else {
              el.innerHTML = `${prefix}${target.toLocaleString()}${suffix}`;
            }
          }
        }

        requestAnimationFrame(updateCount);
      };

      const countElements = document.querySelectorAll('.stat-count:not([data-manual-count="true"])');
      if (countElements.length > 0) {
        const countObserver = new IntersectionObserver((entries, obs) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              const el = entry.target;
              if (!el.closest('.specialty-stat-item')) {
                window.animateSingleCount(el);
                obs.unobserve(el);
              }
            }
          });
        }, { threshold: 0.2 });

        countElements.forEach(el => {
          if (!el.closest('.specialty-stat-item')) {
            countObserver.observe(el);
          }
        });
      }

      // Desktop Staggered Stat Box Scroll Parallax Fallback
      if (window.innerWidth > 900 && !CSS.supports('(animation-timeline: view()) and (animation-range: entry)')) {
        const container = document.querySelector('.staggered-cards-container');
        const rightCol = document.querySelector('.staggered-col-right');
        if (container && rightCol) {
          let ticking = false;
          const updateParallax = () => {
            if (window.innerWidth <= 900) return;
            const rect = container.getBoundingClientRect();
            const windowHeight = window.innerHeight;
            if (rect.bottom >= 0 && rect.top <= windowHeight) {
              const totalDist = windowHeight + rect.height;
              const progress = (windowHeight - rect.top) / totalDist;
              const clamped = Math.max(0, Math.min(1, progress));
              const translateY = 130 - clamped * 260;
              rightCol.style.transform = `translateY(${translateY}px)`;
            }
            ticking = false;
          };
          window.addEventListener('scroll', () => {
            if (!ticking) {
              requestAnimationFrame(updateParallax);
              ticking = true;
            }
          }, { passive: true });
          updateParallax();
        }
      }

      // Title Color Wipe Reveal Observer (Faded to Full Color Left-to-Right)
      const colorWipeElements = document.querySelectorAll('.title-color-wipe');
      if (colorWipeElements.length > 0) {
        if ('IntersectionObserver' in window) {
          const colorWipeObserver = new IntersectionObserver((entries, obs) => {
            entries.forEach(entry => {
              if (entry.isIntersecting) {
                entry.target.classList.add('revealed');
                obs.unobserve(entry.target);
              }
            });
          }, { threshold: 0.15, rootMargin: '0px 0px -50px 0px' });

          colorWipeElements.forEach(el => colorWipeObserver.observe(el));
        } else {
          colorWipeElements.forEach(el => el.classList.add('revealed'));
        }
      }

      // Rewired List Items Bottom-Up Staggered Reveal Observer
      const rewiredItems = document.querySelectorAll('.rewired-list-item');
      if (rewiredItems.length > 0) {
        if ('IntersectionObserver' in window) {
          const rewiredObserver = new IntersectionObserver((entries, obs) => {
            entries.forEach(entry => {
              if (entry.isIntersecting) {
                entry.target.classList.add('revealed');
                obs.unobserve(entry.target);
              }
            });
          }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });

          rewiredItems.forEach(item => rewiredObserver.observe(item));
        } else {
          rewiredItems.forEach(item => item.classList.add('revealed'));
        }
      }

      // Process Cards Bottom-Up Staggered Reveal Observer
      const processCards = document.querySelectorAll('.process-card-featured, .process-card-secondary');
      const processGrid = document.querySelector('.process-cards-grid');
      if (processCards.length > 0) {
        if ('IntersectionObserver' in window) {
          if (window.innerWidth > 991 && processGrid) {
            const gridObserver = new IntersectionObserver((entries, obs) => {
              entries.forEach(entry => {
                if (entry.isIntersecting) {
                  processCards.forEach(card => card.classList.add('revealed'));
                  obs.unobserve(entry.target);
                }
              });
            }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });

            gridObserver.observe(processGrid);
          } else {
            const cardObserver = new IntersectionObserver((entries, obs) => {
              entries.forEach(entry => {
                if (entry.isIntersecting) {
                  entry.target.classList.add('revealed');
                  obs.unobserve(entry.target);
                }
              });
            }, { threshold: 0.15, rootMargin: '0px 0px -30px 0px' });

            processCards.forEach(card => cardObserver.observe(card));
          }
        } else {
          processCards.forEach(card => card.classList.add('revealed'));
        }
      }

      // Brand Staggered Grid Scroll Reveal Observer
      const brandGrid = document.querySelector('.brand-staggered-grid');
      if (brandGrid) {
        if ('IntersectionObserver' in window) {
          const brandObserver = new IntersectionObserver((entries, obs) => {
            entries.forEach(entry => {
              if (entry.isIntersecting) {
                entry.target.classList.add('revealed');
                obs.unobserve(entry.target);
              }
            });
          }, { threshold: 0.1, rootMargin: '0px 0px -30px 0px' });
          brandObserver.observe(brandGrid);
        } else {
          brandGrid.classList.add('revealed');
        }
      }

      // Built Properly, From Ground Up 01-05 Mobile Bottom-Up Reveal Observer
      const builtCards = document.querySelectorAll('.built-groundup-section .built-point-card');
      const builtHeader = document.querySelector('.built-groundup-section .built-groundup-header');
      if (builtCards.length > 0) {
        if ('IntersectionObserver' in window && window.innerWidth <= 768) {
          const builtMobileObserver = new IntersectionObserver((entries, obs) => {
            entries.forEach(entry => {
              if (entry.isIntersecting) {
                entry.target.classList.add('revealed');
                obs.unobserve(entry.target);
              }
            });
          }, { threshold: 0.15, rootMargin: '0px 0px -30px 0px' });

          if (builtHeader) builtMobileObserver.observe(builtHeader);
          builtCards.forEach(card => builtMobileObserver.observe(card));
        } else {
          if (builtHeader) builtHeader.classList.add('revealed');
          builtCards.forEach(card => card.classList.add('revealed'));
        }
      }

      // Universal Hero Text Entrance & Scroll Animation for Service/Content Pages
      document.querySelectorAll('.hero-service-headline').forEach(headline => {
        if (!headline.querySelector('.hero-title-line')) {
          const raw = headline.innerHTML.trim();
          const parts = raw.split(/<br\s*\/?>/i);
          headline.innerHTML = parts
            .map(part => `<span class="hero-title-line-mask"><span class="hero-title-line">${part.trim()}</span></span>`)
            .join('');
        }
      });

      const serviceHeroTitleLines = document.querySelectorAll(
        '.hero-editorial-service .hero-title-line, .hero-editorial-automation .hero-title-line'
      );
      const serviceHeroTextItems = document.querySelectorAll(
        '.hero-editorial-service .hero-service-content > *:not(.hero-service-headline), .hero-editorial-automation .hero-text-block > *'
      );

      if (serviceHeroTitleLines.length > 0 || serviceHeroTextItems.length > 0) {
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        let initialLoaded = false;

        const loadTimer = setTimeout(() => {
          initialLoaded = true;
          serviceHeroTitleLines.forEach(line => {
            line.style.animation = 'none';
            line.style.transform = 'translateY(0%)';
            line.style.opacity = '1';
          });
          serviceHeroTextItems.forEach(item => {
            item.style.animation = 'none';
            item.style.transform = 'translateX(0%)';
            item.style.opacity = '1';
          });
        }, 1800);

        function updateServiceHeroScroll() {
          if (prefersReducedMotion) return;

          const scrollY = window.scrollY || window.pageYOffset;

          if (scrollY > 5 && !initialLoaded) {
            initialLoaded = true;
            clearTimeout(loadTimer);
            serviceHeroTitleLines.forEach(line => {
              line.style.animation = 'none';
            });
            serviceHeroTextItems.forEach(item => {
              item.style.animation = 'none';
            });
          }

          if (!initialLoaded && scrollY === 0) return;

          const maxScroll = 320;
          const scrollProgress = Math.min(Math.max(scrollY / maxScroll, 0), 1);

          // 1. Hero Title Lines (Animate Upwards -Y out of mask)
          serviceHeroTitleLines.forEach((line, index) => {
            const start = index * 0.12;
            const end = Math.min(start + 0.76, 1);

            let lineProgress = 0;
            if (scrollProgress > start) {
              lineProgress = Math.min((scrollProgress - start) / (end - start), 1);
            }

            const translateY = -120 * lineProgress;
            const opacity = 1 - lineProgress;

            line.style.transform = `translateY(${translateY.toFixed(2)}%)`;
            line.style.opacity = opacity.toFixed(3);
          });

          // 2. Hero Subtitle, Description & Actions (Animate Rightwards +X off screen)
          serviceHeroTextItems.forEach((item, index) => {
            const start = index * 0.10;
            const end = Math.min(start + 0.80, 1);

            let itemProgress = 0;
            if (scrollProgress > start) {
              itemProgress = Math.min((scrollProgress - start) / (end - start), 1);
            }

            const translateX = 115 * itemProgress;
            const opacity = 1 - itemProgress;

            item.style.transform = `translateX(${translateX.toFixed(2)}%)`;
            item.style.opacity = opacity.toFixed(3);
          });
        }

        let serviceHeroScrollTicking = false;
        window.addEventListener('scroll', () => {
          if (!serviceHeroScrollTicking) {
            requestAnimationFrame(() => {
              updateServiceHeroScroll();
              serviceHeroScrollTicking = false;
            });
            serviceHeroScrollTicking = true;
          }
        }, { passive: true });

        window.addEventListener('resize', () => {
          updateServiceHeroScroll();
        }, { passive: true });

        updateServiceHeroScroll();
      }
    });
  </script>
</body>

</html>