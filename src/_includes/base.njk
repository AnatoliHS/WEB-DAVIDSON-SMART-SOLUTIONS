<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{ title | default("Automation - Convenience at your fingertips") }} — {{ site.title }}</title>
  <meta name="description" content="{{ description | default(site.description) }}" />

  <!-- Google Fonts & Font Awesome Icons -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&display=swap"
    rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

  <!-- Editorial Stylesheet -->
  <link rel="stylesheet" href="/assets/css/style.css?v=7.7" />

  <!-- Favicon -->
  <link rel="icon"
    href="https://i0.wp.com/quintesmarthomes.ca/wp-content/uploads/2023/06/Quinte-Smart-Homes-House-Logo.png?fit=32%2C32&ssl=1"
    sizes="32x32" />
</head>

<body class="{% if isBusinessPage or page.url == '/business/' %}business-portal{% endif %}{% if page.url == '/contact/' or page.url == '/contact' %} contact-page{% endif %}">
  <!-- Thinking Wave Visualizer Ring around Closed Navbar Circle (Desktop Only) -->
  <div class="pill-thinking-orb" id="pillThinkingOrb" aria-hidden="true">
    <canvas class="orb-wave-canvas" id="orbWaveCanvas" width="140" height="140"></canvas>
  </div>

  <!-- Desktop Expanding Pill Navigation (Desktop Only: min-width 901px) -->
  <aside class="desktop-pill-nav" id="desktopPillNav" aria-label="Main Navigation">
    <!-- Circle Bulb Trigger Button (Always visible on left) -->
    <button class="pill-bulb-btn" id="pillBulbBtn" aria-label="Open Navigation Menu" aria-expanded="false" title="Menu">
      <img src="/assets/bulb-black.png" alt="Davidson Smart Solutions Logo" class="pill-bulb-icon bulb-icon-dark" />
      <img src="/assets/bulb-white.png" alt="Davidson Smart Solutions Commercial Logo"
        class="pill-bulb-icon bulb-icon-light" />
      <img src="/assets/davidson-logo.png" alt="Davidson Smart Solutions Wordmark" class="pill-expanded-logo" />
    </button>

    <!-- Expanded Long Pill Content Wrapper -->
    <div class="pill-content" id="pillContent">
      <div class="pill-divider" aria-hidden="true"></div>

      <nav class="pill-nav-links" aria-label="Desktop Menu">
        {% include "components/nav-links.njk" %}
      </nav>

      <div class="pill-divider" aria-hidden="true"></div>

      <div class="pill-actions">
        <a href="/contact/" class="btn btn-primary pill-btn-consult">Book Consultation</a>
        {% if page.url == "/business/" or isBusinessPage %}
        <a href="/" class="link-arrow pill-switch-link">Residential <i class="fa-solid fa-arrow-right"></i></a>
        {% else %}
        <a href="/business/" class="link-arrow pill-switch-link">Commercial <i class="fa-solid fa-arrow-right"></i></a>
        {% endif %}
      </div>

      <!-- Close Trigger Button on the right of the pill -->
      <button class="pill-close-btn" id="pillCloseBtn" aria-label="Close Navigation Menu" title="Close Menu">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>
  </aside>

  <!-- Mobile Navigation Backdrop Overlay -->
  <div class="mobile-island-backdrop" id="mobileIslandBackdrop" aria-hidden="true"></div>

  <!-- Mobile Constant Floating Dark Glass Pill Navbar (Mobile Only: max-width 900px) -->
  <!-- Mobile Constant Floating Dark Glass Pill Navbar (Mobile Only: max-width 900px) -->
  <header class="mobile-island-header" id="mobileIslandHeader">
    <div class="mobile-island-shell" id="mobileIslandShell">
      <div class="mobile-island-bar" id="mobileIslandBar">
        <!-- Left: 2-Line Minimal Hamburger -->
        <div class="island-left-group">
          <button class="mobile-island-toggle-btn" id="mobileIslandToggle" aria-label="Toggle navigation menu" aria-expanded="false" type="button">
            <span class="island-toggle-box">
              <span class="island-toggle-bar bar-top"></span>
              <span class="island-toggle-bar bar-bot"></span>
            </span>
          </button>
        </div>

        <!-- Center: Brand Logo Home Navigation -->
        <a href="{% if isBusinessPage or page.url == '/business/' %}/business/{% else %}/{% endif %}" class="mobile-island-bulb-btn mobile-island-brand-link" id="mobileIslandBulbBtn" aria-label="Davidson Smart Solutions Home">
          <img src="/assets/davidson-logo.png" alt="Davidson Smart Solutions Logo" class="mobile-island-brand-logo" />
        </a>

        <!-- Center: Switch to Division Pill (between X and message icon when drawer is open) -->
        <div class="island-bar-switch-wrap" id="islandBarSwitchWrap">
          {% if page.url == "/business/" or isBusinessPage %}
          <a href="/" class="drawer-switch-link drawer-switch-residential island-bar-switch-link">
            <span class="switch-link-text">Switch to Residential</span>
            <i class="fa-solid fa-arrow-right drawer-switch-arrow"></i>
          </a>
          {% else %}
          <a href="/business/" class="drawer-switch-link drawer-switch-commercial island-bar-switch-link">
            <span class="switch-link-text">Switch to Commercial</span>
            <i class="fa-solid fa-arrow-right drawer-switch-arrow"></i>
          </a>
          {% endif %}
        </div>

        <!-- Right: Connect Action Link -->
        <div class="island-right-group">
          <a href="/contact/" class="mobile-island-connect-btn" aria-label="Connect" title="Connect">
            <i class="fa-regular fa-message"></i>
          </a>
        </div>
      </div>

      <!-- The Floating Dark Glass Dropdown Expansion Drawer -->
      <nav class="mobile-island-dropdown" id="mobileIslandDropdown" aria-label="Mobile Navigation" aria-hidden="true">
      <div class="island-dropdown-scroll">

        <!-- Editorial Navigation Links Stack -->
        <div class="drawer-editorial-nav" id="drawerEditorialNav">
          <!-- 1. Home -->
          <div class="drawer-nav-row">
            <a href="{% if isBusinessPage or page.url == '/business/' %}/business/{% else %}/{% endif %}"
               class="drawer-nav-link">
              <span>Home</span>
            </a>
          </div>

          <!-- 2. Services Dropdown -->
          <div class="drawer-nav-row drawer-has-sub">
            <button class="drawer-nav-link drawer-sub-toggle" id="drawerServicesToggle" aria-expanded="false" type="button">
              <span>Services</span>
              <i class="fa-solid fa-chevron-down drawer-chevron"></i>
            </button>
            <div class="drawer-sub-menu" id="drawerServicesMenu">
              {% if isBusinessPage or page.url == "/business/" %}
              <a href="/services/business-security/" class="drawer-sub-link">
                <span>Small Business Security</span>
              </a>
              <a href="/services/business-networking/" class="drawer-sub-link">
                <span>Business Networking</span>
              </a>
              <a href="/services/construction-security/" class="drawer-sub-link">
                <span>Construction Site Security</span>
              </a>
              {% else %}
              <a href="/services/networking/" class="drawer-sub-link">
                <span>Home Networking</span>
              </a>
              <a href="/services/starlink/" class="drawer-sub-link">
                <span>Starlink Installation</span>
              </a>
              <a href="/services/home-security/" class="drawer-sub-link">
                <span>Home Security</span>
              </a>
              <a href="/services/audio/" class="drawer-sub-link">
                <span>Architectural Audio</span>
              </a>
              <a href="/services/home-theatre/" class="drawer-sub-link">
                <span>Home Theatre</span>
              </a>
              <a href="/services/outdoor-screens/" class="drawer-sub-link">
                <span>Outdoor Screens</span>
              </a>
              <a href="/services/smart-lights/" class="drawer-sub-link">
                <span>Smart Lights</span>
              </a>
              <a href="/services/window-shades/" class="drawer-sub-link">
                <span>Window Shades</span>
              </a>
              <a href="/services/pergola/" class="drawer-sub-link">
                <span>Louvered Pergola</span>
              </a>
              {% endif %}
            </div>
          </div>

          <!-- 3. About Dropdown -->
          <div class="drawer-nav-row drawer-has-sub">
            <button class="drawer-nav-link drawer-sub-toggle" id="drawerAboutToggle" aria-expanded="false" type="button">
              <span>About</span>
              <i class="fa-solid fa-chevron-down drawer-chevron"></i>
            </button>
            <div class="drawer-sub-menu" id="drawerAboutMenu">
              <a href="/about/" class="drawer-sub-link">
                <span>About Company</span>
              </a>
              <a href="/about/smart-home-automation/" class="drawer-sub-link">
                <span>About Smart Home</span>
              </a>
              <a href="/portfolio/" class="drawer-sub-link">
                <span>Portfolio</span>
              </a>
            </div>
          </div>

          <!-- 4. Industry Professionals -->
          <div class="drawer-nav-row">
            <a href="/industry-professionals/" class="drawer-nav-link">
              <span>Industry Professionals</span>
            </a>
          </div>

          <!-- 5. Start Your Project -->
          <div class="drawer-nav-row">
            <a href="/contact/" class="drawer-nav-link drawer-nav-link-project" aria-label="Start Your Project">
              <span>Start Your Project</span>
              <svg class="drawer-project-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="6" y1="18" x2="18" y2="6"></line>
                <polyline points="9 6 18 6 18 15"></polyline>
              </svg>
            </a>
          </div>
        </div>

        <!-- Drawer Brand Footer Logo with Animated Thinking Wave Aura around Bulb -->
        <div class="drawer-footer-brand">
          <a href="{% if isBusinessPage or page.url == '/business/' %}/business/{% else %}/{% endif %}" class="drawer-brand-logo-link" aria-label="Davidson Smart Solutions Home">
            <div class="drawer-logo-wave-wrap" aria-hidden="true">
              <canvas class="orb-wave-canvas drawer-wave-canvas" id="drawerOrbWaveCanvas" width="140" height="140"></canvas>
            </div>
            <img src="/assets/davidson-logo.png" alt="Davidson Smart Solutions Logo" class="drawer-brand-logo-img" />
          </a>
        </div>

      </div>
    </nav>
    </div>
  </header>

  <!-- Main Content -->
  <main id="main-content">
    {{ content | safe }}
  </main>

  <!-- Editorial Footer -->
  <footer class="site-footer">
    <div class="container">
      <div class="footer-grid">
        <div>
          <a href="/" class="brand-logo" style="margin-bottom: 1.5rem; display: inline-block;">
            <img src="/assets/davidson-logo.png" alt="Davidson Smart Solutions Logo"
              style="height: 135px; width: auto; max-width: 420px; object-fit: contain; filter: brightness(0) invert(1);" />
          </a>
          <p style="font-size: 0.9rem; line-height: 1.7; margin-bottom: 1.5rem; color: #a3a3a3; max-width: 340px;">
            Premier electrical and home technology firm. Whole home automation, Lutron lighting, audio/visual
