        <div class="footer-col">
          <h4>Contact</h4>
          <ul class="footer-links">
            <li><i class="fa-solid fa-phone" style="color: var(--color-accent); margin-right: 0.5rem;"></i> <a href="tel:{{ site.phone or '613-779-9044' }}">{{ site.phone or '613-779-9044' }}</a></li>
            <li><i class="fa-solid fa-envelope" style="color: var(--color-accent); margin-right: 0.5rem;"></i> <a href="mailto:{{ site.email or 'info@quintesmarthomes.ca' }}">{{ site.email or 'info@quintesmarthomes.ca' }}</a></li>
            <li><i class="fa-solid fa-location-dot" style="color: var(--color-accent); margin-right: 0.5rem;"></i> <span style="color: #d4d4d4;">{{ site.address or 'Belleville, ON &amp; Surrounding Quinte Region' }}</span></li>
