<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{% if title %}{{ title }}{% else %}Davidson Smart Solutions | Smart Home Automation & Electrical Services{% endif %}</title>

  <meta name="description"
    content="Davidson Smart Solutions provides premium smart home automation, Lutron lighting, Starlink installation, and custom security across Belleville, Prince Edward County, and Eastern Ontario." />
  <meta name="keywords"
    content="Davidson Smart Solutions, Smart Home Automation, Lutron RadioRA3, Starlink Installation, Security Systems, Master Electrician Belleville, Prince Edward County" />
  <meta name="author" content="Davidson Smart Solutions" />
  <meta name="robots" content="index, follow" />
  <meta name="revisit-after" content="7 days" />
  <meta name="language" content="English" />

  <meta property="og:title" content="{{ title }}" />
  <meta property="og:description" content="Premium smart home automation, lighting, networking, and security solutions across Eastern Ontario." />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://quintesmarthomes.com/" />
  <meta property="og:image" content="https://quintesmarthomes.com/assets/images/smart_home_automation_hero.jpg" />
  <meta property="og:site_name" content="Davidson Smart Solutions" />

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Electrician",
    "name": "Davidson Smart Solutions",
    "url": "https://quintesmarthomes.com",
    "description": "Master electricians offering luxury smart home automation, Lutron lighting control, Starlink internet installation, and enterprise security.",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Belleville",
      "addressRegion": "ON",
      "addressCountry": "CA"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": "45.4215",
      "longitude": "-75.6972"
    },
    "priceRange": "$$$",
    "telephone": "613-805-1111"
  }
  </script>

  {% if faqSchema %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {% for item in faqSchema %}
      {
        "@type": "Question",
        "name": {{ item.question | dump | safe }},
        "acceptedAnswer": {
          "@type": "Answer",
          "text": {{ item.answer | dump | safe }}
        }
      }{% if not loop.last %},{% endif %}
      {% endfor %}
    ]
  }
  </script>
  {% endif %}

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preconnect" href="https://www.rate-my-agent.com" crossorigin />

  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300..800;1,300..800&display=swap" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300..800;1,300..800&display=swap" media="print" onload="this.media='all'" />

  <style>
    /* Clean, Modern CSS Reset */
    *, *::before, *::after {
      box-sizing: border-box;
    }
    body, h1, h2, h3, h4, h5, h6, p, figure, blockquote, dl, dd {
      margin: 0;
      padding: 0;
    }
    ul, ol {
      list-style: none;
      margin: 0;
      padding: 0;
    }
    body {
      min-height: 100vh;
      text-rendering: optimizeSpeed;
      line-height: 1.5;
      font-family: var(--font-body, system-ui, sans-serif);
      background-color: #fafafa;
      color: #1a1a1a;
      margin: 0;
      padding: 0;
    }
    a {
      color: inherit;
      text-decoration: none;
    }
    a:not([class]) {
      text-decoration-skip-ink: auto;
    }
    img, picture {
      max-width: 100%;
      display: block;
    }
    input, button, textarea, select {
      font: inherit;
      background: none;
      border: none;
      margin: 0;
      padding: 0;
    }
    button {
      cursor: pointer;
    }
    @media (prefers-reduced-motion: reduce) {
      html:focus-within {
        scroll-behavior: auto;
      }
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
      }
    }
    :root {
      --font-body: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      --font-heading: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      --oklch-light-green: oklch(80%, 0.15, 145);
      --oklch-dark-green: oklch(45%, 0.2, 145);
      --oklch-light-blue: oklch(80%, 0.14, 250);
      --oklch-dark-blue: oklch(15%, 0.2, 250);
      --oklch-light-brown: oklch(60%, 0.25, 70);
      --oklch-dark-brown: oklch(30%, 0.35, 70);
      --oklch-light-yellow: oklch(95%, 0.1, 100);
      --oklch-dark-yellow: oklch(75%, 0.22, 90);
      --oklch-light-gray: oklch(90%, 0.01, 0);
      --oklch-dark-gray: oklch(20%, 0+5, 150);
    }

    body {
      font-family: var(--font-body);
    }

    /* Fixed global background */
    body::before {
      content: "";
      position: fixed;
      top: 0;
      left: 0;
      height: 100dvh;
      width: 100vw;
      z-index: -1;

      background-size: cover;
      margin: 0;
      padding: 0;
    }

    .coming-soon {
      flex: 1;
      padding: 10px;
      text-align: center;
      color: black;
    }

    .info-box {
      flex: 1;
      text-align: center;
      color: black;
    }

    .info-box img {
      width: 20%;
    }

    .content {
      width: calc(100% - 20px);
      max-width: 1300px;
      padding: 20px 5rem;
      margin: 0 auto;
      margin-bottom: 10px;
    }

    .content2 {
      width: calc(100% - 20px);
      max-width: 1000px;
      padding: 20px 5rem;
      background-color: rgba(255, 255, 255, 0.9);
      border-radius: 5px;
      box-shadow: 5px 5px 10px rgba(0, 0, 0, 0.8);
      margin: 0 auto;
      margin-bottom: 10px;
    }

    .content3 {
      width: calc(100% - 20px);
      max-width: 800px;
      padding: 40px 5rem;
      background: linear-gradient(to bottom, #f2f2f2, #ffffff);
      border-radius: 5px;
      box-shadow: 5px 5px 10px rgba(0, 0, 0, 0.8);
      margin: 0 auto;
      margin-bottom: 50px;
      margin-top: -20px;
      font-size: 20px;
      color: black;
      text-align: left;
    }

    .cert-wrapper {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 20px;
    }

    .cert-links {
      flex: 1;
    }

    .cert-link {
      display: block;
      color: black;
      padding-left: 30px;
      margin-bottom: 10px;
      text-decoration: none;
      background: url('https://cdn-icons-png.flaticon.com/512/845/845646.png') no-repeat left center;
      background-size: 20px;
    }

    .cert-image {
      width: 150px;
      height: auto;
      object-fit: contain;
    }

    .content-fees {
      width: calc(100% - 20px);
      max-width: 1300px;
      padding: 20px 1rem;
      background-color: rgba(255, 255, 255, 0.9);
      border-radius: 5px;
      box-shadow: 5px 5px 10px rgba(0, 0, 0, 0.8);
      margin: 0 auto;
      margin-bottom: 10px;
    }

    .content-about {
      width: calc(100% - 20px);
      max-width: 800px;
      padding: 20px 1rem;
      background-color: rgba(255, 255, 255, 0.9);
      border-radius: 5px;
      box-shadow: 5px 5px 10px rgba(0, 0, 0, 0.8);
      margin: 0 auto;
      margin-bottom: 10px;
    }

    @media (max-width: 1310px) {
      .info-box {
        flex-basis: 100%;
      }

      .info-box img {
        max-width: 100px;
      }

      .coming-soon img {
        max-width: 30em;
      }

      div[style*="display: flex"] {
        flex-direction: column;
      }

      .content {
        padding: 20px 1rem;
      }

      .content2 {
        padding: 20px 1rem;
      }

      nav img {
        display: none !important;
      }

      .whmis-carousel {
        display: none !important;
      }

      .header {
        min-width: 42em;
      }

      .content3 img {
        display: none !important;
      }
    }

    * {
      box-sizing: border-box;
    }

    .slideshow-container {
      max-width: 900px;
      position: relative;
      margin: 50px auto;
      background: #fff;
      padding: 30px 20px;
      border-radius: 10px;
      box-shadow: 5px 10px 10px rgba(0, 0, 0, 0.6);
    }

    .mySlides {
      display: none;
    }

    .review-content {
      text-align: center;
    }

    .review-header {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 15px;
      margin-bottom: 15px;
    }

    .user-img {
      width: 50px;
      height: 50px;
      border-radius: 50%;
    }

    .stars {
      font-size: 20px;
      color: gold;
    }

    .google-logo {
      height: 25px;
    }

    .review-text {
      font-size: 16px;
      line-height: 1.5;
      color: #333;
      margin-top: 10px;
      padding: 0 10px;
    }

    .prev,
    .next {
      cursor: pointer;
      position: absolute;
      top: 50%;
      width: auto;
      padding: 16px;
      margin-top: -22px;
      font-weight: bold;
      font-size: 22px;
      transition: 0.3s ease;
      user-select: none;
      color: black;
    }

    .next {
      right: 0;
    }

    .prev {
      left: 0;
    }

    .prev:hover,
    .next:hover {
      background-color: rgba(0, 0, 0, 0.1);
    }

    .text {
      display: none;
    }

    .numbertext {
      color: #999;
      font-size: 12px;
      position: absolute;
      top: 8px;
      left: 16px;
    }

    .dot-container {
      text-align: center;
      margin-top: 15px;
    }

    .dot {
      cursor: pointer;
      height: 12px;
      width: 12px;
      margin: 0 4px;
      background-color: #bbb;
      border-radius: 50%;
      display: inline-block;
      transition: background-color 0.6s ease;
    }

    .active,
    .dot:hover {
      background-color: #717171;
    }

    @keyframes fade {
      from {
        opacity: .4
      }

      to {
        opacity: 1
      }
    }

    .fade {
      animation-name: fade;
      animation-duration: 1s;
    }
  </style>

  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="manifest" href="/site.webmanifest" />
</head>