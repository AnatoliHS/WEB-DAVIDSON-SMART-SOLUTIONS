<style>
    /* New Footer CSS */
    .re-footer {
        background: #2370ba;
        color: #ffffff;
        border-top: 1px solid rgba(255, 255, 255, 0.1);
        padding: 5rem 5% 3rem 5%;
        font-family: var(--font-body, 'Plus Jakarta Sans', sans-serif);
    }

    .re-footer-container {
        max-width: 1200px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 40px;
    }

    .re-footer-col h3 {
        font-size: 1.2rem;
        font-weight: 600;
        margin-bottom: 20px;
        color: #ffffff;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    .re-footer-col p {
        font-size: 0.95rem;
        line-height: 1.6;
        color: rgba(255, 255, 255, 0.8);
        margin-bottom: 10px;
    }

    .re-footer-col a {
        color: #ffffff;
        text-decoration: none;
        transition: color 0.3s ease;
    }

    .re-footer-col a:hover {
        color: #38bdf8;
        text-decoration: underline;
    }

    .re-footer-links {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .re-footer-links li {
        margin-bottom: 12px;
    }

    .re-footer-bottom {
        max-width: 1200px;
        margin: 30px auto 0;
        padding-top: 20px;
        border-top: 1px solid rgba(255, 255, 255, 0.15);
        text-align: center;
        font-size: 0.85rem;
        color: rgba(255, 255, 255, 0.7);
    }

    .re-footer-bottom p {
        margin: 0;
        color: rgba(255, 255, 255, 0.7);
    }

    .re-footer-socials {
        display: flex;
        gap: 12px;
        margin-top: 20px;
    }

    .social-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.12);
        color: #ffffff;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .social-icon svg {
        width: 18px;
        height: 18px;
        fill: currentColor;
    }

    .social-icon:hover {
        background: #ffffff;
        color: #2370ba;
        transform: translateY(-3px) scale(1.05);
        box-shadow: 0 4px 12px rgba(255, 255, 255, 0.25);
    }

    .google-preferred-badge {
        position: fixed;
        bottom: 24px;
        right: 24px;
        z-index: 99999;
        display: inline-flex;
        align-items: center;
        gap: 0;
        height: 48px;
        width: 48px;
        max-width: 48px;
        padding: 0;
        justify-content: center;
        background: var(--color-accent, #C5A059);
        color: #ffffff;
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 24px;
        text-decoration: none;
        font-family: var(--font-body, system-ui, -apple-system, sans-serif);
        font-weight: 600;
        font-size: 14px;
        box-shadow: 0 4px 14px rgba(158, 139, 125, 0.35);
        transition: max-width 0.35s cubic-bezier(0.4, 0, 0.2, 1),
            padding 0.35s cubic-bezier(0.4, 0, 0.2, 1),
            gap 0.35s cubic-bezier(0.4, 0, 0.2, 1),
            background 0.2s ease,
            box-shadow 0.2s ease;
        overflow: hidden;
        white-space: nowrap;
    }

    .google-preferred-badge .google-preferred-icon {
        flex-shrink: 0;
        width: 22px;
        height: 22px;
        fill: #ffffff;
        color: #ffffff;
    }

    .google-preferred-badge .google-preferred-text {
        opacity: 0;
        max-width: 0;
        overflow: hidden;
        color: #ffffff;
        transition: opacity 0.25s ease, max-width 0.35s cubic-bezier(0.4, 0, 0.2, 1);
        pointer-events: none;
    }

    .google-preferred-badge:hover,
    .google-preferred-badge:focus-visible {
        max-width: 260px;
        width: auto;
        padding: 0 18px 0 14px;
        gap: 10px;
        background: #C5A059;
        box-shadow: 0 6px 20px rgba(158, 139, 125, 0.45);
    }

    .google-preferred-badge:hover .google-preferred-text,
    .google-preferred-badge:focus-visible .google-preferred-text {
        opacity: 1;
        max-width: 200px;
    }

    /* Business Portal Signature Midnight Navy Gradient */
    body.business-portal .google-preferred-badge {
        background: linear-gradient(135deg, #232B3B 0%, #171C26 100%) !important;
        border-color: rgba(255, 255, 255, 0.3) !important;
        box-shadow: 0 4px 18px rgba(35, 43, 59, 0.38) !important;
    }

    body.business-portal .google-preferred-badge:hover,
    body.business-portal .google-preferred-badge:focus-visible {
        background: linear-gradient(135deg, #2E384D 0%, #202735 100%) !important;
        box-shadow: 0 6px 24px rgba(35, 43, 59, 0.55) !important;
    }

    @media (max-width: 768px) {
        .google-preferred-badge {
            bottom: 16px;
            right: 16px;
            max-width: 280px;
            width: auto;
            padding: 0 16px 0 12px;
            gap: 8px;
        }

        .google-preferred-badge .google-preferred-text {
            opacity: 1;
            max-width: 200px;
        }
    }
</style>

