<style>
  /* Premium Dynamic Navbar CSS */
  .re-navbar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 0.5rem 5%;
    background-color: #2370ba;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 4px 20px rgba(15, 23, 42, 0.05);
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    box-sizing: border-box;
    z-index: 1000;
    transition: padding 0.4s cubic-bezier(0.4, 0, 0.2, 1), background-color 0.4s ease, box-shadow 0.4s ease, grid-template-columns 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .re-navbar.scrolled {
    padding: 0.35rem 5%;
    grid-template-columns: 1fr auto 1fr;
    background-color: #2370ba;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
  }

  .re-logo-link {
    text-decoration: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    justify-self: center;
    position: relative;
  }

  .re-logo-link::before {
    display: none;
  }

  .re-navbar.scrolled .re-logo-link::before {
    display: none;
  }

  .re-logo-img {
    height: 110px;
    width: auto;
    max-width: none !important;
    transition: height 0.4s cubic-bezier(0.4, 0, 0.2, 1), transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    transform: translateY(0);
    position: relative;
    z-index: 2;
  }

  .re-navbar.scrolled .re-logo-img {
    height: 60px;
    transform: translateY(0);
    filter: none;
  }

  .re-logo-text {
    display: none;
  }

  .re-nav-links {
    display: flex;
    gap: 30px;
    list-style: none;
    margin: 0;
    padding: 0;
    align-items: center;
  }

  .left-links {
    justify-self: end;
    padding-right: 30px;
  }

  .right-links {
    justify-self: start;
    padding-left: 30px;
  }

  .re-nav-links a {
    text-decoration: none;
    color: #ffffff;
    font-weight: 500;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: color 0.3s ease;
  }

  .re-nav-links a:hover {
    color: #38bdf8;
  }

  /* Premium Desktop Dropdown Styles */
  .re-nav-dropdown {
    position: relative;
    display: inline-block;
  }

  .re-dropdown-toggle {
    cursor: pointer;
    display: flex;
    align-items: center;
  }

  .re-dropdown-menu {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%) translateY(10px);
    background-color: #2370ba;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 8px;
    padding: 10px 0;
    list-style: none;
    min-width: 230px;
    opacity: 0;
    visibility: hidden;
    z-index: 1000;
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.15);
    transition: opacity 0.3s ease, transform 0.3s ease, visibility 0.3s ease;
  }

  .re-nav-dropdown:hover .re-dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }

  .re-dropdown-menu li {
    width: 100%;
    margin: 0;
    padding: 0;
  }

  .re-dropdown-menu a {
    display: block;
    padding: 10px 20px;
    color: #ffffff;
    text-transform: none !important;
    font-size: 0.95rem !important;
    font-weight: 500 !important;
    letter-spacing: 0.5px !important;
    text-align: left;
    white-space: nowrap;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .re-dropdown-menu a:hover {
    background-color: rgba(255, 255, 255, 0.1);
    color: #38bdf8 !important;
  }

  .arrow-icon {
    display: inline-block;
    margin-left: 6px;
    font-size: 0.75rem;
    transition: transform 0.3s ease;
    line-height: 1;
  }

  .re-nav-dropdown:hover .arrow-icon {
    transform: rotate(180deg);
  }

  .re-nav-contact {
    padding: 8px 20px;
    background-color: #ffffff;
    color: #2370ba !important;
    border-radius: 4px;
    font-weight: 700 !important;
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  .re-nav-contact:hover {
    background-color: #f1f5f9;
    color: #1d5f9e !important;
  }

  /* Premium Animated Hamburger Menu Styles */
  .mobile-toggle-btn {
    display: none;
    background: transparent !important;
    border: none !important;
    width: 28px;
    height: 20px;
    position: relative;
    cursor: pointer;
    padding: 0 !important;
    outline: none !important;
    box-shadow: none !important;
    -webkit-tap-highlight-color: transparent !important;
  }

  .mobile-toggle-btn span {
    display: block;
    position: absolute;
    height: 2.5px;
    width: 100%;
    background: #ffffff;
    border-radius: 4px;
    opacity: 1;
    left: 0;
    transform: rotate(0deg);
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .mobile-toggle-btn span:nth-child(1) {
    top: 0px;
  }

  .mobile-toggle-btn span:nth-child(2),
  .mobile-toggle-btn span:nth-child(3) {
    top: 8px;
  }

  .mobile-toggle-btn span:nth-child(4) {
    top: 16px;
  }

  /* Active state transitions */
  .mobile-toggle-btn.active span:nth-child(1) {
    top: 8px;
    width: 0%;
    left: 50%;
    opacity: 0;
  }

  .mobile-toggle-btn.active span:nth-child(2) {
    transform: rotate(45deg);
  }

  .mobile-toggle-btn.active span:nth-child(3) {
    transform: rotate(-45deg);
  }

  .mobile-toggle-btn.active span:nth-child(4) {
    top: 8px;
    width: 0%;
    left: 50%;
    opacity: 0;
  }

  .mobile-nav-dropdown {
    display: none;
    flex-direction: column;
    background-color: #2370ba;
    border-bottom: none !important;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 999;
    padding: 0 5%;
    gap: 0;
    box-shadow: none !important;
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
    transition: max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.3s ease, padding 0.3s ease;
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.3) transparent;
  }

  .mobile-nav-dropdown::-webkit-scrollbar {
    width: 6px;
  }

  .mobile-nav-dropdown::-webkit-scrollbar-track {
    background: transparent;
  }

  .mobile-nav-dropdown::-webkit-scrollbar-thumb {
    background-color: rgba(255, 255, 255, 0.3);
    border-radius: 3px;
  }

  .mobile-nav-dropdown.active {
    max-height: calc(100vh - 100%);
    max-height: calc(100dvh - 100%);
    overflow-y: auto;
    opacity: 1;
    padding: 1.4rem 5% 1.8rem 5%;
    pointer-events: auto;
    gap: 0.2rem;
  }

  .mobile-nav-dropdown a {
    text-decoration: none;
    color: #ffffff;
    font-size: 1.05rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    padding: 0.85rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    display: block;
    transition: color 0.25s ease;
  }

  .mobile-nav-dropdown a:last-child {
    border-bottom: none;
  }

  .mobile-nav-dropdown a:hover {
    color: #38bdf8;
  }

  /* Mobile Accordion Styles */
  .mobile-accordion {
    width: 100%;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    background-color: #2370ba !important;
    background: #2370ba !important;
  }

  .mobile-accordion-btn {
    width: 100%;
    background: transparent;
    border: none;
    color: #ffffff;
    font-size: 1.05rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    padding: 0.85rem 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    font-family: inherit;
    transition: color 0.25s ease;
  }

  .mobile-accordion-btn:hover {
    color: #38bdf8;
  }

  .mobile-accordion-btn:focus,
  .mobile-accordion-btn:active,
  .mobile-accordion-btn:focus-visible {
    outline: none !important;
    box-shadow: none !important;
    background: transparent !important;
    -webkit-tap-highlight-color: transparent !important;
  }

  .mobile-accordion-content {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
    display: flex;
    flex-direction: column;
    padding-left: 15px;
    background-color: #2370ba !important;
    background: #2370ba !important;
  }

  .mobile-accordion.active .mobile-accordion-content {
    max-height: 300px;
  }

  .mobile-accordion-content a {
    border-bottom: none !important;
    padding: 0.6rem 0 !important;
    font-size: 0.95rem !important;
    font-weight: 500 !important;
    text-transform: none !important;
    letter-spacing: 0.5px !important;
  }

  .mobile-accordion-btn .arrow-icon {
    display: inline-block;
    transition: transform 0.3s ease;
    font-size: 0.85rem;
  }

  .mobile-accordion.active .mobile-accordion-btn .arrow-icon {
    transform: rotate(180deg);
  }

  .mobile-nav-dropdown a.mobile-contact-btn {
    background: #ffffff;
    color: #2370ba !important;
    text-align: center;
    border-radius: 6px;
    font-weight: 800;
    padding: 0.9rem;
    border: none;
    margin-top: 0.8rem;
    display: block;
  }

  @media (max-width: 1024px) {
    .re-navbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.5rem 5%;
    }

    .re-nav-links {
      display: none;
    }

    .mobile-toggle-btn {
      display: block;
    }

    .re-logo-link {
      flex-direction: row;
      gap: 10px;
    }

    .re-logo-link::before {
      display: none !important;
    }

    .re-logo-img {
      display: block !important;
      height: 55px !important;
      transform: none !important;
    }

    .re-navbar.scrolled .re-logo-img {
      display: block !important;
      height: 55px !important;
      transform: none !important;
      filter: none !important;
    }

    .re-logo-text {
      display: none !important;
    }

    .mobile-nav-dropdown {
      display: flex;
    }
  }

  /* Complete outline, border, and shadow removal for mobile accordion button and its children */
  .mobile-accordion-btn,
  .mobile-accordion-btn *,
  .mobile-accordion-btn:hover,
  .mobile-accordion-btn:focus,
  .mobile-accordion-btn:active,
  .mobile-accordion-btn:focus-visible,
  button.mobile-accordion-btn,
  button.mobile-accordion-btn:focus,
  button.mobile-accordion-btn:active,
  button.mobile-accordion-btn:focus-visible {
    outline: none !important;
    outline-width: 0 !important;
    box-shadow: none !important;
    border: none !important;
    border-color: transparent !important;
    border-width: 0 !important;
    background: transparent !important;
    background-color: transparent !important;
    -webkit-tap-highlight-color: transparent !important;
  }

</style>

