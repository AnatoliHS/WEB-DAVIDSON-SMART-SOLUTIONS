{# Floating control panel: styles & script. Include once per page; works for any number of control-panel.njk instances. #}
<!-- Floating control panel styles & script -->
<style>
  .cp-visual {
    --cp-accent: #C5A059;
    --cp-accent-rgb: 197, 160, 89;
    --cp-night: #8ea2e0;      /* moon on the dark night-scene thumb */
    --cp-night-rgb: 142, 162, 224;
    --cp-cool: #8ea2e0;       /* climate icon while cooling / setback */
    --cp-cool-rgb: 142, 162, 224;
    --cp-text-3: rgba(255, 255, 255, 0.48);
    display: grid;
    justify-items: center;
    min-width: 0;
  }
  /* Business pages: blue instead of gold; setback climate in an icier blue */
  .cp-visual.is-business {
    --cp-accent: #8ea2e0;
    --cp-accent-rgb: 142, 162, 224;
    --cp-cool: #a9dcf2;
    --cp-cool-rgb: 169, 220, 242;
  }

  .cp-stage { position: relative; width: 100%; max-width: 520px; aspect-ratio: 5 / 6; container-type: inline-size; color: #ffffff; font-family: var(--font-sans); }
  .cp-stage { perspective: 1400px; display: grid; place-items: center; }
  .ui-panel {
    --rx: 5deg; --ry: -9deg;
    position: relative; width: 78%; aspect-ratio: 4 / 5; transform-style: preserve-3d;
    transform: rotateX(var(--rx)) rotateY(var(--ry)); transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    border-radius: 6cqw; padding: 6cqw 5.5cqw;
    background: linear-gradient(160deg, rgba(44, 44, 48, 0.92), rgba(18, 18, 20, 0.95));
    border: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow: 0 6cqw 14cqw rgba(0, 0, 0, 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.08);
    display: flex; flex-direction: column; gap: 3.5cqw;
  }
  /* Greeting on top, full-width scene switch beneath it */
  .ui-top { display: grid; gap: 3cqw; transform: translateZ(20px); }
  .ui-top small { display: block; font-size: 2.3cqw; letter-spacing: 0.14em; text-transform: uppercase; color: var(--cp-text-3); font-weight: 700; }
  .ui-top b { display: block; font-size: 4.4cqw; font-weight: 700; color: #ffffff; margin-top: 0.6cqw; transition: opacity 0.3s ease; }

  /* Morning / Bedtime switch: a sliding white thumb behind two labels */
  .ui-switch { position: relative; display: grid; grid-template-columns: 1fr 1fr; padding: 0.8cqw; border-radius: 99px; background: rgba(255, 255, 255, 0.07); border: 1px solid rgba(255, 255, 255, 0.12); }
  .ui-switch::before { content: ''; position: absolute; top: 0.8cqw; bottom: 0.8cqw; left: 0.8cqw; width: calc(50% - 0.8cqw); border-radius: 99px; background: #f4f1ea; box-shadow: 0 1cqw 3cqw rgba(0, 0, 0, 0.35); transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1); }
  .ui-switch[data-pos="1"]::before { transform: translateX(100%); }
  .ui-switch button { position: relative; z-index: 1; font: inherit; cursor: pointer; border: 0; background: none; display: inline-flex; align-items: center; justify-content: center; gap: 1.2cqw; padding: 2cqw 2.8cqw; font-size: 2.5cqw; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: rgba(255, 255, 255, 0.6); transition: color 0.4s ease; white-space: nowrap; }
  .ui-switch button[aria-pressed="true"] { color: #141414; }
  .ui-switch button i { font-size: 2.4cqw; }
  .ui-switch button[aria-pressed="true"] i { color: var(--cp-accent); }
  /* Night scene (Bedtime / Closed): the thumb turns dark, with white text and the cool-blue moon */
  .ui-switch::before { transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), background 0.5s ease, border-color 0.5s ease; border: 1px solid transparent; box-sizing: border-box; }
  .ui-switch[data-pos="1"]::before { background: #0f1116; border-color: rgba(var(--cp-night-rgb), 0.4); box-shadow: 0 1cqw 3cqw rgba(0, 0, 0, 0.5), 0 0 3cqw rgba(var(--cp-night-rgb), 0.18); }
  .ui-switch[data-pos="1"] button[aria-pressed="true"] { color: #ffffff; }
  .ui-switch[data-pos="1"] button[aria-pressed="true"] i { color: var(--cp-night); filter: drop-shadow(0 0 1.2cqw rgba(var(--cp-night-rgb), 0.6)); }

  .ui-tiles { flex: 1; display: grid; grid-template-columns: 1fr 1fr; gap: 3cqw; transform-style: preserve-3d; }
  /* Tiles stay put; only their contents change (icon colour, value, bar) */
  .ui-tile {
    position: relative; border-radius: 3.6cqw; padding: 3.4cqw; display: flex; flex-direction: column; justify-content: space-between;
    background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1);
    transform: translateZ(10px);
  }
  /* Icon is grey when the device is off / closed / disarmed, accent-coloured when it's on / open / active */
  .ui-tile i { font-size: 4.2cqw; color: rgba(255, 255, 255, 0.35); transition: color 0.6s ease, filter 0.6s ease; }
  .ui-tile.is-active i { color: var(--cp-accent); filter: drop-shadow(0 0 1.6cqw rgba(var(--cp-accent-rgb), 0.45)); }
  /* Cooling (night-scene climate) */
  .ui-tile.is-active.is-cool i { color: var(--cp-cool); filter: drop-shadow(0 0 1.8cqw rgba(var(--cp-cool-rgb), 0.65)); }
  .ui-tile span { font-size: 2.3cqw; letter-spacing: 0.1em; text-transform: uppercase; font-weight: 700; color: var(--cp-text-3); }
  .ui-tile strong { display: block; font-size: 3.6cqw; color: #ffffff; margin-top: 0.6cqw; font-weight: 700; transition: opacity 0.18s ease; }
  .ui-tile.is-changing strong { opacity: 0.35; }
  .ui-bar { height: 0.9cqw; border-radius: 1cqw; background: rgba(255, 255, 255, 0.1); overflow: hidden; margin-top: 1.6cqw; }
  .ui-bar b { display: block; height: 100%; width: var(--w, 100%); background: rgba(255, 255, 255, 0.85); transition: width 1.1s cubic-bezier(0.65, 0, 0.35, 1); }

  @media (max-width: 991px), (hover: none) and (pointer: coarse) {
    .ui-panel { --rx: 3deg; --ry: -5deg; }
  }

  @media (prefers-reduced-motion: reduce) {
    .cp-visual * { transition: none !important; }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const small = () => isMobileLayout(991);
    const inView = (el, cb, threshold) => {
      if (!('IntersectionObserver' in window)) return cb(true);
      new IntersectionObserver(es => es.forEach(e => cb(e.isIntersecting)), { threshold }).observe(el);
    };

    /* Floating control panel with a two-scene switch (Morning / Bedtime, or Open / Closed) */
    document.querySelectorAll('.cp-stage').forEach(stage => {
      // Scenes & devices (from _data/controlPanel.json); each tile has a state per scene key.
      // `bar` is the fill %, `on` lights its icon, `cool` uses the cooling colour
      const CFG = JSON.parse(stage.querySelector('script[type="application/json"]').textContent);
      const TILES = CFG.tiles;
      const [DAY, NIGHT] = CFG.scenes;
      const GREET = Object.fromEntries(CFG.scenes.map(c => [c.key, c.greet]));
      stage.innerHTML = `
        <div class="ui-panel">
          <div class="ui-top">
            <div><small>${CFG.brand}</small><b>${DAY.greet}</b></div>
            <div class="ui-switch" role="group" aria-label="Scene" data-pos="0">
              ${CFG.scenes.map((c, i) => `<button type="button" data-scene="${c.key}" aria-pressed="${i === 0}"><i class="fa-solid ${c.icon}"></i> ${c.label}</button>`).join('')}
            </div>
          </div>
          <div class="ui-tiles">${TILES.map(t => { const st = t[DAY.key]; return `<div class="ui-tile${st.on ? ' is-active' : ''}"><i class="fa-solid ${t.icon}"></i><div><span>${t.name}</span><strong>${st.text}</strong>${st.bar !== undefined ? `<div class="ui-bar"><b style="--w:${st.bar}%"></b></div>` : ''}</div></div>`; }).join('')}</div>
        </div>`;
      const panel = stage.querySelector('.ui-panel');
      const sw = stage.querySelector('.ui-switch');
      const btns = [...sw.querySelectorAll('button')];
      const tiles = [...stage.querySelectorAll('.ui-tile')];
      const greet = stage.querySelector('.ui-top b');
      let scene = DAY.key;
      let timers = [];

      // Switch scene: thumb slides, then each tile's value, icon and bar update in turn (tiles themselves stay still)
      const setScene = (next) => {
        if (next === scene) return;
        scene = next;
        timers.forEach(clearTimeout);
        timers = [];
        sw.dataset.pos = next === NIGHT.key ? '1' : '0';
        btns.forEach(b => b.setAttribute('aria-pressed', String(b.dataset.scene === next)));
        // Greeting changes once the last tile has updated
        if (reduce) greet.textContent = GREET[next];
        else timers.push(setTimeout(() => { greet.textContent = GREET[next]; }, 250 + tiles.length * 320 + 220));
        tiles.forEach((el, i) => {
          const st = TILES[i][next];
          const apply = () => {
            el.querySelector('strong').textContent = st.text;
            el.classList.toggle('is-active', !!st.on);
            el.classList.toggle('is-cool', !!st.cool);
            const b = el.querySelector('.ui-bar b');
            if (b) b.style.setProperty('--w', `${st.bar}%`);
          };
          if (reduce) { apply(); return; }
          const d = 250 + i * 320;
          // Value text dips briefly while it changes; the bar slides to its new level
          timers.push(setTimeout(() => el.classList.add('is-changing'), d));
          timers.push(setTimeout(apply, d + 180));
          timers.push(setTimeout(() => el.classList.remove('is-changing'), d + 360));
        });
      };

      // Showcase: day → night scene shortly after it scrolls into view, then alternate until the visitor takes over
      let auto = null, userTook = false;
      const startAuto = () => {
        if (userTook || reduce || auto) return;
        auto = setTimeout(function tick() {
          setScene(scene === DAY.key ? NIGHT.key : DAY.key);
          auto = setTimeout(tick, 6000);
        }, 1400);
      };
      const stopAuto = () => { clearTimeout(auto); auto = null; };
      btns.forEach(b => b.addEventListener('click', () => { userTook = true; stopAuto(); setScene(b.dataset.scene); }));
      inView(stage, vis => (vis ? startAuto() : stopAuto()), 0.5);

      // Tilt toward the cursor on desktop
      stage.addEventListener('pointermove', e => {
        if (e.pointerType !== 'mouse' || small() || reduce) return;
        const r = stage.getBoundingClientRect();
        const nx = (e.clientX - r.left) / r.width - 0.5, ny = (e.clientY - r.top) / r.height - 0.5;
        panel.style.setProperty('--ry', `${-9 + nx * 10}deg`);
        panel.style.setProperty('--rx', `${5 - ny * 7}deg`);
      });
      stage.addEventListener('pointerleave', () => { panel.style.removeProperty('--ry'); panel.style.removeProperty('--rx'); });
    });
  });
</script>
